@attribute [Route(pageUrl)]
@layout DocsMainLayout

<SiteMetaTags PageUrl="@pageUrl" Title="@metaTitle" Description="@metaDescription" ImageUrl="@imageUrl" />

<PageHero Title="@pageTitle">
    <SubTitleTemplate>
        @((MarkupString)pageDescription)
    </SubTitleTemplate>
</PageHero>

<div class="content">
    <Section Class="p-0" Size="HeadingSize.H4" Name="Prerequisites" PageUrl="@pageUrl" Link="prerequisites">
        <Block>
            <ul>
                <li>.NET 8 SDK (<a href="https://dotnet.microsoft.com/download/dotnet/8.0" target="_blank">Download</a>) or later version</li>
                <li>Visual Studio 2022 or later / VS Code / Other</li>
                <li>Basic knowledge of Blazor Web Apps</li>
            </ul>
        </Block>
    </Section>


    <Section Class="p-0" Size="HeadingSize.H4" Name="1. Manual Installation" PageUrl="@pageUrl" Link="1-manual-installation">
        <Block>
            <ol>
                <li>
                    <b>Run .NET CLI command:</b>
                    <CodeChunk Class="mt-3" LanguageCode="LanguageCode.Text" FilePath="~\Pages\Docs\GettingStarted\net8\02_A_Manual_Install_01_Run_Net_CLI_Command_Snippet.razor" ProjectRootClassType="DemoAppConstants.ProjectRootClassType" />
                </li>
                <li>
                    <b>Add package reference:</b>
                    <CodeChunk Class="mt-3" LanguageCode="LanguageCode.Text" FilePath="~\Pages\Docs\GettingStarted\net8\02_A_Manual_Install_02_Add_Package_Reference_Snippet.razor" ProjectRootClassType="DemoAppConstants.ProjectRootClassType" />
                </li>
                <li>
                    <b>Add JS references:</b>
                    <Block>Insert the following references into the <code>body</code> section of the <code>Components/App.razor</code> file, immediately after the <code>_framework/blazor.web.js</code> reference:</Block>
                    <CodeChunk Class="mt-3" LanguageCode="LanguageCode.HTML" FilePath="~\Pages\Docs\GettingStarted\net8\01_A_Manual_Install_03_Snippet.html" ProjectRootClassType="DemoAppConstants.ProjectRootClassType" />
                </li>
                <li>
                    <b>Add the namespace:</b>
                    <Block>Add the <code>BlazorExpress.ChartJS</code> namespace to <code>_Imports.razor</code>. The library needs no service registration.</Block>
                    <CodeChunk Class="mt-3" LanguageCode="LanguageCode.Razor" FilePath="~\Pages\Docs\GettingStarted\net8\01_A_Manual_Install_04_Snippet.razor" ProjectRootClassType="DemoAppConstants.ProjectRootClassType" />
                </li>
            </ol>
        </Block>
    </Section>

    <Section Class="p-0" Size="HeadingSize.H4" Name="2. Usage Example" PageUrl="@pageUrl" Link="2-usage-example">
        <Block>
            <ol>
                <li>
                    <Block>Add a BarChart component to <code>Components/Pages/Home.razor</code>:</Block>
                    <CodeChunk Class="mt-3" LanguageCode="LanguageCode.Razor" FilePath="~\Pages\Docs\GettingStarted\net8\01_A_Manual_Install_06_Snippet.razor" ProjectRootClassType="DemoAppConstants.ProjectRootClassType" />
                </li>
            </ol>
        </Block>
    </Section>

    <Section Class="p-0" Size="HeadingSize.H4" Name="3. Troubleshooting" PageUrl="@pageUrl" Link="3-troubleshooting">
        <Block>
            <ul>
                <li>Ensure all JS references are correct in <code>App.razor</code>.</li>
                <li>Restart the development server after making changes to static files.</li>
                <li>Check the browser console for errors if components do not render as expected.</li>
            </ul>
        </Block>
    </Section>

    <Section Class="p-0" Size="HeadingSize.H4" Name="References" PageUrl="@pageUrl" Link="references">
        <Block>
            <ul>
                <li>
                    <a href="https://github.com/BlazorExpress/BlazorExpress.ChartJS" target="_blank">GitHub Repository</a>
                </li>
                <li>
                    <a href="https://www.nuget.org/packages/BlazorExpress.ChartJS" target="_blank">NuGet Package</a>
                </li>
            </ul>
        </Block>
    </Section>
</div>

@code {
    private const string pageUrl = DemoRouteConstants.Docs_Getting_Started_Blazor_WebApp_NET_8_Interactive_Render_Mode_Server_Global_Location;
    private const string pageTitle = "Getting started - Blazor WebApp (.NET 8) - Interactive render mode Server - Global location";
    private const string pageDescription = "Learn how to quickly set up <code>BlazorExpress.ChartJS</code> in your Blazor WebApp (Server) project by installing the package and adding the scripts.";
    private const string metaTitle = "Blazor Web App (Server) Setup Guide";
    private const string metaDescription = "Step-by-step guide to using BlazorExpress.ChartJS: package install, script references and a first chart for Blazor WebApp (Server) apps.";
    private const string imageUrl = DemoImageSrcConstants.BarChart;
}

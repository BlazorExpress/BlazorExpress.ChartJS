<div class="columns is-multiline">
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">Position: x <code>Position = "top"</code>, y <code>Position = "right"</code></p>
        <LineChart @ref="positionChart" />
    </div>
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">Reverse: y <code>Reverse = true</code> (lower values at the top, as for a ranking)</p>
        <LineChart @ref="reverseChart" />
    </div>
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">x <code>Reverse = true</code>, y <code>Display = false</code></p>
        <LineChart @ref="hiddenAxisChart" />
    </div>
</div>

@code {
    private LineChart positionChart = default!;
    private LineChart reverseChart = default!;
    private LineChart hiddenAxisChart = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var positionOptions = new LineChartOptions();
            positionOptions.Scales.X!.Position = "top";
            positionOptions.Scales.Y!.Position = "right";

            var reverseOptions = new LineChartOptions();
            reverseOptions.Scales.Y!.Reverse = true;

            var hiddenAxisOptions = new LineChartOptions();
            hiddenAxisOptions.Scales.X!.Reverse = true; // June first, January last
            hiddenAxisOptions.Scales.Y!.Display = false; // no y labels, ticks or grid lines

            await positionChart.InitializeAsync(GetChartData(), positionOptions);
            await reverseChart.InitializeAsync(GetChartData(), reverseOptions);
            await hiddenAxisChart.InitializeAsync(GetChartData(), hiddenAxisOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    #region Data Preparation

    private static ChartData GetChartData() => new()
    {
        Labels = ["January", "February", "March", "April", "May", "June"],
        Datasets =
        [
            CreateDataset("Team A", 0, [8, 6, 5, 3, 2, 1]),
            CreateDataset("Team B", 1, [3, 4, 2, 5, 6, 4])
        ]
    };

    private static LineChartDataset CreateDataset(string label, int colorIndex, List<double?> data)
    {
        var c = ColorUtility.CategoricalTwelveColors[colorIndex].ToColor();

        return new LineChartDataset
        {
            Label = label,
            Data = data,
            BackgroundColor = c.ToRgbaString(0.5),
            BorderColor = c.ToRgbString(),
            BorderWidth = 2
        };
    }

    #endregion Data Preparation
}

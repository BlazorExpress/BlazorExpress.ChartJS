<LineChart @ref="lineChart" Width="600" />

<div class="mt-3">
    <button type="button" class="button is-small mr-1 @(isCentered ? "is-primary" : null)" @onclick="() => SetCenteredAsync(true)">Position = "center"</button>
    <button type="button" class="button is-small @(isCentered ? null : "is-primary")" @onclick="() => SetCenteredAsync(false)">Default positions</button>
</div>

@code {
    private LineChart lineChart = default!;
    private ChartData chartData = default!;
    private readonly LineChartOptions options = new() { Responsive = true };
    private bool isCentered = true;

    protected override void OnInitialized()
    {
        chartData = new ChartData
        {
            // An odd number of labels puts "0" in the middle, where the centred y-axis is drawn.
            Labels = ["-4", "-3", "-2", "-1", "0", "1", "2", "3", "4"],
            Datasets =
            [
                new LineChartDataset
                {
                    Label = "y = x³",
                    Data = [-64, -27, -8, -1, 0, 1, 8, 27, 64],
                    BorderColor = "rgb(0, 114, 178)", // Okabe–Ito blue
                    BackgroundColor = "rgb(0, 114, 178)",
                    Tension = 0.4,
                },
            ]
        };

        // The same range on both sides of zero puts zero, and so the centred x-axis, in the middle.
        options.Scales.Y!.Min = -70;
        options.Scales.Y!.Max = 70;
        ApplyPositions();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await lineChart.InitializeAsync(chartData, options);

        await base.OnAfterRenderAsync(firstRender);
    }

    private void ApplyPositions()
    {
        options.Scales.X!.Position = isCentered ? "center" : "bottom";
        options.Scales.Y!.Position = isCentered ? "center" : "left";
    }

    private async Task SetCenteredAsync(bool centered)
    {
        isCentered = centered;
        ApplyPositions();
        await lineChart.UpdateAsync(chartData, options);
    }
}

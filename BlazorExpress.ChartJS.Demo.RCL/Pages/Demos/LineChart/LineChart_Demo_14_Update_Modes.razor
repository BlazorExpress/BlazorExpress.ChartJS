<LineChart @ref="lineChart" Width="600" />

<div class="mt-3">
    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="RefreshAsync">Refresh (animated)</Button>
    <Button Color="ButtonColor.Info" Size="ButtonSize.Small" @onclick="RefreshWithoutAnimationAsync">Refresh without animation</Button>
    <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="ResetAsync">Reset</Button>
    <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="StopAsync">Stop</Button>
    <Button Color="ButtonColor.Link" Size="ButtonSize.Small" @onclick="RenderAsync">Render</Button>
    <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="ClearAsync">Clear</Button>
</div>

<p class="mt-3 mb-0">@status</p>

@code {
    private LineChart lineChart = default!;
    private LineChartOptions lineChartOptions = default!;
    private ChartData chartData = default!;
    private readonly List<string> labels = new() { "January", "February", "March", "April", "May", "June" };
    private readonly Dictionary<string, string> colors = new() { ["Desktop"] = "54, 162, 235", ["Mobile"] = "255, 159, 64" };
    private string status = "Animations take 2 seconds here, so there is time to click Stop.";

    protected override void OnInitialized()
    {
        chartData = CreateChartData();
        lineChartOptions = new LineChartOptions { Responsive = true, Animation = new ChartAnimation { Duration = 2000 } };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await lineChart.InitializeAsync(chartData, lineChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task ClearAsync()
    {
        await lineChart.ClearAsync();
        status = "Cleared the canvas. Click Render to draw the chart again. While an animation runs, its next frame draws over the cleared canvas, so click Stop first.";
    }

    private ChartData CreateChartData() =>
        new()
        {
            Labels = labels,
            Datasets = colors.Keys
                .Select(label => (IChartDataset)new LineChartDataset
                {
                    Label = label,
                    Data = labels.Select(_ => (double?)Random.Shared.Next(10, 80)).ToList(),
                    BackgroundColor = $"rgb({colors[label]})",
                    BorderColor = $"rgb({colors[label]})",
                })
                .ToList(),
        };

    private async Task RefreshAsync()
    {
        chartData = CreateChartData();
        await lineChart.UpdateAsync(chartData, lineChartOptions);
        status = "Applied new data with the default animation, drawn from the chart's starting state.";
    }

    private async Task RefreshWithoutAnimationAsync()
    {
        chartData = CreateChartData();
        await lineChart.UpdateAsync(chartData, lineChartOptions, ChartUpdateMode.None);
        status = "Applied new data at once, without animation.";
    }

    private async Task RenderAsync()
    {
        await lineChart.RenderAsync();
        status = "Redrew the chart as it is now, for example after Clear.";
    }

    // Stop first: a running animation would draw over the reset state on its next frame.
    private async Task ResetAsync()
    {
        await lineChart.StopAsync();
        await lineChart.ResetAsync();
        await lineChart.RenderAsync();
        status = "Reset the chart to its starting state, before its first animation. Click Refresh (animated) to see an update animate from here.";
    }

    private async Task StopAsync()
    {
        await lineChart.StopAsync();
        status = "Stopped any running animation. The chart stays as it was drawn at that moment.";
    }
}

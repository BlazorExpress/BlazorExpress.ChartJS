<LineChart @ref="lineChart" Width="600" />

<div class="mt-3">
    @foreach (var boundary in boundaries)
    {
        <button type="button" class="button is-small mr-1 @(boundary.Text == current ? "is-primary" : null)" @onclick="() => SetFillAsync(boundary.Text, boundary.Value)">@boundary.Text</button>
    }
</div>

<p class="mt-3 mb-0"><code>Fill = @current</code></p>

@code {
    private LineChart lineChart = default!;
    private LineChartDataset dataset = default!;
    private ChartData chartData = default!;
    private readonly LineChartOptions options = new() { Responsive = true };
    private string current = "\"origin\"";

    // false: no fill. "origin": to the zero line. "start": to the bottom of the chart area. "end": to the top.
    private readonly (string Text, object Value)[] boundaries =
    [
        ("false", false), ("\"origin\"", "origin"), ("\"start\"", "start"), ("\"end\"", "end"),
    ];

    protected override void OnInitialized()
    {
        dataset = new LineChartDataset
        {
            Label = "Balance",
            Data = [40, -20, 55, -35, 30, -10, 45], // values on both sides of zero show the difference between the boundaries
            BorderColor = "rgb(0, 114, 178)", // Okabe–Ito blue (colour-blind safe)
            BackgroundColor = "rgba(0, 114, 178, 0.35)",
            Fill = "origin",
        };

        chartData = new ChartData
        {
            Labels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul"],
            Datasets = [dataset],
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await lineChart.InitializeAsync(chartData, options);

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task SetFillAsync(string text, object value)
    {
        current = text;
        dataset.Fill = value;
        await lineChart.UpdateAsync(chartData, options);
    }
}

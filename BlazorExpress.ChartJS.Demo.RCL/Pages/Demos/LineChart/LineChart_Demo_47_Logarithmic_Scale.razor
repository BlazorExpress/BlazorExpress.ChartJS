<LineChart @ref="lineChart" Width="600" />

<div class="mt-3">
    <button type="button" class="button is-small mr-1 @(scaleType == "logarithmic" ? "is-primary" : null)" @onclick="@(() => SetScaleTypeAsync("logarithmic"))">logarithmic</button>
    <button type="button" class="button is-small @(scaleType == "linear" ? "is-primary" : null)" @onclick="@(() => SetScaleTypeAsync("linear"))">linear</button>
</div>

<p class="mt-3 mb-0"><code>Scales.Y.Type = "@scaleType"</code></p>

@code {
    private LineChart lineChart = default!;
    private ChartData chartData = default!;
    private readonly LineChartOptions options = new() { Responsive = true };
    private string scaleType = "logarithmic";

    protected override void OnInitialized()
    {
        chartData = new ChartData
        {
            Labels = ["Week 1", "Week 2", "Week 3", "Week 4", "Week 5", "Week 6", "Week 7"],
            Datasets =
            [
                // Each value is about ten times the one before: a straight line on a logarithmic axis.
                new LineChartDataset
                {
                    Label = "Downloads",
                    Data = [3, 25, 310, 2800, 31000, 290000, 3100000],
                    BorderColor = "rgb(0, 114, 178)", // Okabe–Ito blue
                    BackgroundColor = "rgb(0, 114, 178)",
                },
                new LineChartDataset
                {
                    Label = "Signups",
                    Data = [1, 4, 18, 70, 260, 1100, 4200],
                    BorderColor = "rgb(230, 159, 0)", // Okabe–Ito orange
                    BackgroundColor = "rgb(230, 159, 0)",
                },
            ]
        };

        // A logarithmic axis cannot show zero or negative values, so BeginAtZero stays off.
        options.Scales.Y!.Type = scaleType;
        options.Scales.Y!.BeginAtZero = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await lineChart.InitializeAsync(chartData, options);

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task SetScaleTypeAsync(string type)
    {
        scaleType = type;
        options.Scales.Y!.Type = type;
        await lineChart.UpdateAsync(chartData, options);
    }
}

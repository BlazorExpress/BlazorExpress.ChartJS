@implements IDisposable

<LineChart role="img" aria-label="Line chart: server room temperature in °C, the last 30 readings, one every 2 seconds, updating live" @ref="lineChart" Width="600" />

@code {
    private const int MaxReadings = 30;

    private LineChart lineChart = default!;
    private LineChartOptions lineChartOptions = default!;
    private ChartData chartData = default!;
    private readonly List<ChartTimePoint> readings = new();
    private readonly Random random = new();
    // Created with the component, so Dispose always stops it, even when the page is left before the chart has initialized.
    private readonly PeriodicTimer timer = new(TimeSpan.FromSeconds(2));

    protected override void OnInitialized()
    {
        // Start with the last minute of readings, so the chart is full from the first frame.
        var start = DateTime.Now.AddSeconds(-2 * MaxReadings);
        for (var i = 1; i <= MaxReadings; i++)
            readings.Add(new ChartTimePoint(start.AddSeconds(2 * i), NextTemperature()));

        var color = ColorUtility.CategoricalTwelveColors[6].ToColor();

        chartData = new ChartData
        {
            Datasets = new List<IChartDataset>
            {
                new LineChartDataset
                {
                    Label = "Server room (°C)",
                    TimeData = readings,
                    BackgroundColor = color.ToRgbaString(),
                    BorderColor = color.ToRgbString(),
                },
            },
        };

        lineChartOptions = new LineChartOptions { Responsive = true };
        lineChartOptions.Scales.X = new ChartAxes
        {
            Type = ChartAxesType.Time,
            Time = new ChartAxesTime { Unit = ChartTimeUnit.Second, DisplayFormats = new ChartAxesTimeDisplayFormats { Second = "HH:mm:ss" }, TooltipFormat = "HH:mm:ss" },
        };
        lineChartOptions.Scales.Y = new ChartAxes { BeginAtZero = false, SuggestedMin = 20, SuggestedMax = 24 };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await lineChart.InitializeAsync(chartData, lineChartOptions);
            _ = ReadSensorAsync();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    // The timer stands in for a real feed. With SignalR, the hub handler calls the same update method instead:
    // hubConnection.On<Reading>("reading", reading => InvokeAsync(() => AddReadingAsync(reading)));
    private async Task ReadSensorAsync()
    {
        // WaitForNextTickAsync returns false once the timer is disposed, which ends the loop.
        while (await timer.WaitForNextTickAsync())
            await InvokeAsync(() => AddReadingAsync(new Reading(DateTime.Now, NextTemperature())));
    }

    private async Task AddReadingAsync(Reading reading)
    {
        // Append the new reading and drop the oldest, so the chart shows a moving window of MaxReadings points.
        readings.Add(new ChartTimePoint(reading.Time, reading.Value));
        if (readings.Count > MaxReadings)
            readings.RemoveAt(0);

        await lineChart.UpdateAsync(chartData, lineChartOptions);
    }

    private double NextTemperature() => Math.Round(21.5 + random.NextDouble() * 1.5, 1);

    public void Dispose() => timer.Dispose();

    public record Reading(DateTime Time, double Value);
}

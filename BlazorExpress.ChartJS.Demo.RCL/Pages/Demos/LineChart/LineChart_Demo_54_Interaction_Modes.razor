<LineChart @ref="lineChart" Width="600" />

<div class="mt-3">
    <span class="mr-2">Mode:</span>
    @foreach (var value in modes)
    {
        <button type="button" class="button is-small mr-1 mb-1 @(value == mode ? "is-primary" : null)" @onclick="() => SetInteractionAsync(value, intersect)">@value</button>
    }
</div>
<div class="mt-2">
    <span class="mr-2">Intersect:</span>
    <button type="button" class="button is-small mr-1 @(intersect ? "is-info" : null)" @onclick="() => SetInteractionAsync(mode, true)">true</button>
    <button type="button" class="button is-small @(intersect ? null : "is-info")" @onclick="() => SetInteractionAsync(mode, false)">false</button>
</div>

<p class="mt-3 mb-0">Move the pointer over the chart. <code>Interaction = new Interaction { Mode = InteractionMode.@mode, Intersect = @(intersect ? "true" : "false") }</code></p>

@code {
    private LineChart lineChart = default!;
    private ChartData chartData = default!;
    private readonly LineChartOptions options = new() { Responsive = true };
    private readonly InteractionMode[] modes = Enum.GetValues<InteractionMode>();
    private InteractionMode mode = InteractionMode.Index;
    private bool intersect;

    protected override void OnInitialized()
    {
        chartData = new ChartData
        {
            Labels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul"],
            Datasets =
            [
                CreateDataset("Product A", [42, 51, 47, 60, 55, 68, 72], "0, 114, 178"),  // Okabe–Ito blue
                CreateDataset("Product B", [30, 28, 39, 35, 48, 44, 57], "230, 159, 0"),  // Okabe–Ito orange
                CreateDataset("Product C", [15, 22, 19, 27, 24, 33, 31], "0, 158, 115"),  // Okabe–Ito bluish green
            ]
        };

        // Interaction decides which points the pointer selects, for both the hover highlight and the tooltip.
        options.Interaction = new Interaction { Mode = mode, Intersect = intersect };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await lineChart.InitializeAsync(chartData, options);

        await base.OnAfterRenderAsync(firstRender);
    }

    private static LineChartDataset CreateDataset(string label, List<double?> data, string rgb) =>
        new()
        {
            Label = label,
            Data = data,
            BorderColor = $"rgb({rgb})",
            BackgroundColor = $"rgb({rgb})",
            PointRadius = [4],
            PointHoverRadius = [9],
        };

    private async Task SetInteractionAsync(InteractionMode newMode, bool newIntersect)
    {
        mode = newMode;
        intersect = newIntersect;
        options.Interaction = new Interaction { Mode = mode, Intersect = intersect };
        await lineChart.UpdateAsync(chartData, options);
    }
}

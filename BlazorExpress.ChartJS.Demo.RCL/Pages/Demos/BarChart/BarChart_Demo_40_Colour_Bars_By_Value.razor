<BarChart role="img" aria-label="Bar chart: monthly profit in thousand US dollars in 2025, with loss months below zero" @ref="barChart" Width="600" />

<p class="mt-3 mb-0">Green bars, above the zero line, are months with a profit. Red bars, below it, are months with a loss.</p>

@code {
    // Both colours reach at least 3:1 against light and dark page backgrounds.
    private const string ProfitColor = "rgb(29, 158, 117)";
    private const string LossColor = "rgb(216, 90, 48)";

    private BarChart barChart = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            List<double?> profit = [12.4, 8.1, -3.6, 5.2, 9.8, -1.9, -6.3, 4.4, 11.0, 14.7, 7.5, 18.2];

            // One colour per bar, chosen from its value.
            var colors = profit.Select(value => value < 0 ? LossColor : ProfitColor).ToList();

            var chartData = new ChartData
            {
                Labels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
                Datasets =
                [
                    new BarChartDataset
                    {
                        Label = "Profit (red = loss)",
                        Data = profit,
                        BackgroundColor = colors,
                        BorderColor = colors,
                    },
                ],
            };

            var options = new BarChartOptions { Responsive = true };
            options.Plugins.Legend.Display = false; // the sentence under the chart explains the colours
            // null keeps Chart.js's theme-aware default text colour
            options.Scales.Y!.Title = new ChartAxesTitle { Display = true, Text = "Profit (thousand USD)", Color = null };

            await barChart.InitializeAsync(chartData, options);
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}

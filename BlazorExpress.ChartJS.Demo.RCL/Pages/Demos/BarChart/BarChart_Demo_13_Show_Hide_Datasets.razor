<BarChart @ref="barChart" Width="600" OnLegendClick="UpdateVisibleDatasetCountAsync" />

<div class="mt-3">
    @foreach (var label in datasetLabels)
    {
        <button type="button" class="button is-primary is-small mr-1" @onclick="() => ToggleDatasetAsync(label)">Toggle @label</button>
    }
    <button type="button" class="button is-warning is-small" @onclick="() => barChart.HideAsync(datasetLabels.IndexOf(Revenue), March)">Hide March revenue</button>
    <button type="button" class="button is-info is-small" @onclick="() => barChart.ShowAsync(datasetLabels.IndexOf(Revenue), March)">Show March revenue</button>
    <button type="button" class="button is-success is-small" @onclick="RefreshWithoutAnimationAsync">Refresh data without animation</button>
</div>

<p class="mt-3 mb-0">Visible datasets: @visibleDatasetCount of @datasetLabels.Count</p>

@code {
    private const int March = 2;
    private const string Revenue = "Revenue";
    private BarChart barChart = default!;
    private BarChartOptions barChartOptions = default!;
    private ChartData chartData = default!;
    private readonly List<string> datasetLabels = new() { "Revenue", "Costs", "Profit" };
    private readonly Dictionary<string, string> colors = new() { ["Revenue"] = "#36A2EB", ["Costs"] = "#FF9F40", ["Profit"] = "#4BC0C0" };
    private int visibleDatasetCount = 3;

    protected override void OnInitialized()
    {
        chartData = CreateChartData();
        barChartOptions = new BarChartOptions { Responsive = true };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await barChart.InitializeAsync(chartData, barChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private ChartData CreateChartData() =>
        new()
        {
            Labels = new List<string> { "January", "February", "March", "April" },
            Datasets = datasetLabels
                .Select(label => (IChartDataset)new BarChartDataset
                {
                    Label = label,
                    Data = Enumerable.Range(0, 4).Select(_ => (double?)Random.Shared.Next(10, 80)).ToList(),
                    BackgroundColor = new List<string> { colors[label] },
                })
                .ToList(),
        };

    // New data objects, in a new order: hidden datasets and bars stay hidden because they are matched by label.
    private async Task RefreshWithoutAnimationAsync()
    {
        datasetLabels.Reverse();
        chartData = CreateChartData();
        await barChart.UpdateAsync(chartData, barChartOptions, ChartUpdateMode.None);
        await UpdateVisibleDatasetCountAsync();
    }

    private async Task ToggleDatasetAsync(string label)
    {
        var datasetIndex = datasetLabels.IndexOf(label);
        var isVisible = await barChart.IsDatasetVisibleAsync(datasetIndex);

        if (isVisible)
            await barChart.HideAsync(datasetIndex);
        else
            await barChart.ShowAsync(datasetIndex);

        await UpdateVisibleDatasetCountAsync();
    }

    private async Task UpdateVisibleDatasetCountAsync() => visibleDatasetCount = await barChart.GetVisibleDatasetCountAsync();
}

<BarChart @ref="barChart" Width="600" />

<div class="mt-3">
    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="ExportPngAsync">Export PNG</Button>
    <Button Color="ButtonColor.Info" Size="ButtonSize.Small" @onclick="ExportJpegAsync">Export JPEG (quality 0.8)</Button>
    <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="DownloadPngAsync">Download PNG</Button>
</div>

@if (imageDataUrl is not null)
{
    <p class="mt-3 mb-1">Exported @imageDataUrl.Length characters: <code>@imageDataUrl[..Math.Min(30, imageDataUrl.Length)]...</code></p>
    <img src="@imageDataUrl" alt="Exported bar chart image" style="max-width: 300px; border: 1px solid #dee2e6;" />
}

@code {
    private BarChart barChart = default!;
    private BarChartOptions barChartOptions = default!;
    private ChartData chartData = default!;
    private string? imageDataUrl;

    protected override void OnInitialized()
    {
        chartData = new ChartData
        {
            Labels = new List<string> { "January", "February", "March", "April" },
            Datasets = new List<IChartDataset>
            {
                new BarChartDataset { Label = "Revenue", Data = new List<double?> { 40, 55, 62, 70 }, BackgroundColor = new List<string> { "#36A2EB" } },
                new BarChartDataset { Label = "Costs", Data = new List<double?> { 30, 34, 38, 41 }, BackgroundColor = new List<string> { "#FF9F40" } },
            },
        };
        barChartOptions = new BarChartOptions { Responsive = true };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await barChart.InitializeAsync(chartData, barChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task DownloadPngAsync() => await barChart.DownloadImageAsync("sales-chart.png");

    private async Task ExportJpegAsync() => imageDataUrl = await barChart.ToBase64ImageAsync(ChartImageType.Jpeg, 0.8);

    private async Task ExportPngAsync() => imageDataUrl = await barChart.ToBase64ImageAsync();
}

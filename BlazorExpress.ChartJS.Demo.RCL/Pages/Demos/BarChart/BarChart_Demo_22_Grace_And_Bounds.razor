<div class="columns is-multiline">
    <div class="column is-half">
        <p class="has-text-weight-semibold mb-2">y <code>Grace = "10%"</code>: 10% of half the data range added above the highest bar</p>
        <BarChart @ref="gracePercentChart" />
    </div>
    <div class="column is-half">
        <p class="has-text-weight-semibold mb-2">y <code>Grace = 5</code>: 5 data units added above the highest bar</p>
        <BarChart @ref="graceUnitsChart" />
    </div>
    <div class="column is-half">
        <p class="has-text-weight-semibold mb-2">y <code>Bounds = "data"</code> (ends at the highest bar, not the next tick), <code>SuggestedMin = -50</code></p>
        <BarChart @ref="boundsChart" />
    </div>
    <div class="column is-half">
        <p class="has-text-weight-semibold mb-2">Stacked axes: <code>Stack = "demo"</code>, <code>StackWeight</code> 2 and 1, <code>Offset = true</code></p>
        <BarChart @ref="stackedAxesChart" />
    </div>
</div>

@code {
    private BarChart gracePercentChart = default!;
    private BarChart graceUnitsChart = default!;
    private BarChart boundsChart = default!;
    private BarChart stackedAxesChart = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var gracePercentOptions = new BarChartOptions();
            gracePercentOptions.Scales.Y!.Grace = "10%"; // percentage of half the data range

            var graceUnitsOptions = new BarChartOptions();
            graceUnitsOptions.Scales.Y!.Grace = 5; // data units

            var boundsOptions = new BarChartOptions();
            boundsOptions.Scales.Y!.Bounds = "data"; // Chart.js default is "ticks"
            boundsOptions.Scales.Y!.SuggestedMin = -50; // extends the axis below the lowest bar (-37)
            boundsOptions.Scales.Y!.SuggestedMax = 50; // ignored: the data already goes higher (83)

            // y and y2 share the left edge: y takes 2/3 of the height, y2 the other 1/3
            var stackedAxesOptions = new BarChartOptions();
            stackedAxesOptions.Scales.Y!.Position = "left";
            stackedAxesOptions.Scales.Y!.Stack = "demo";
            stackedAxesOptions.Scales.Y!.StackWeight = 2;
            stackedAxesOptions.Scales.Y!.Offset = true;
            stackedAxesOptions.Scales.Y!.Border = new ChartAxesBorder { Color = ColorUtility.CategoricalTwelveColors[0] };
            stackedAxesOptions.Scales.AdditionalAxes = new()
            {
                ["y2"] = new ChartAxes
                {
                    Type = ChartAxesType.Linear,
                    Position = "left",
                    Stack = "demo",
                    StackWeight = 1,
                    Offset = true, // extra space between the two stacked axes
                    Border = new ChartAxesBorder { Color = ColorUtility.CategoricalTwelveColors[1] }
                }
            };

            await gracePercentChart.InitializeAsync(GetChartData([42, 65, 98, 71, 54, 80]), gracePercentOptions);
            await graceUnitsChart.InitializeAsync(GetChartData([42, 65, 98, 71, 54, 80]), graceUnitsOptions);
            await boundsChart.InitializeAsync(GetChartData([-12, 35, 83, -37, 20, 64]), boundsOptions);
            await stackedAxesChart.InitializeAsync(GetStackedChartData(), stackedAxesOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    #region Data Preparation

    private static readonly List<string> labels = ["January", "February", "March", "April", "May", "June"];

    private static ChartData GetChartData(List<double?> data) => new()
    {
        Labels = labels.ToList(),
        Datasets = [CreateDataset("Sales", 0, data)]
    };

    private static ChartData GetStackedChartData()
    {
        var sales = CreateDataset("Sales (y)", 0, [42, 65, 98, 71, 54, 80]);

        var returns = CreateDataset("Returns (y2)", 1, [4, 7, 5, 9, 6, 8]);
        returns.YAxisID = "y2";

        return new ChartData { Labels = labels.ToList(), Datasets = [sales, returns] };
    }

    private static BarChartDataset CreateDataset(string label, int colorIndex, List<double?> data)
    {
        var c = ColorUtility.CategoricalTwelveColors[colorIndex].ToColor();

        return new BarChartDataset
        {
            Label = label,
            Data = data,
            BackgroundColor = [c.ToRgbaString(0.5)],
            BorderColor = [c.ToRgbString()],
            BorderWidth = [2]
        };
    }

    #endregion Data Preparation
}

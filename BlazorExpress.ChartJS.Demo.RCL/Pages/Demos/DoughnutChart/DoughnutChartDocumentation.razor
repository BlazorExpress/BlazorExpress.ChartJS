@attribute [Route(pageUrl)]
@layout DemosMainLayout

<PageMetaTags PageUrl="@pageUrl" Title="@metaTitle" Description="@metaDescription" ImageUrl="@imageUrl" />

<PageHero Title="@pageTitle">
    <SubTitleTemplate>
        @((MarkupString)pageDescription)
    </SubTitleTemplate>
</PageHero>

<DocsLink Href="@DemoRouteConstants.Docs_DoughnutChart" />

<Prerequisites PageUrl="@pageUrl" />

<Section Class="p-0" Size="HeadingSize.H4" Name="How it works" PageUrl="@pageUrl" Link="how-it-works">
    <Block>
        The <strong>Doughnut Chart</strong> component provides a simple way to visualize categorical data as proportional segments of a circle.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Add the <code>DoughnutChart</code> component to your page.</li>
                <li>Define your data and labels using the chart's data model.</li>
                <li>Customize appearance and behavior using the <code>Options</code> property (e.g., colors, legend, tooltips).</li>
                <li>Bind your data and options to the component.</li>
                <li>Refer to the demo code below for a working example and further customization options.</li>
            </ol>
        </div>
        This demo shows how to configure a basic doughnut chart, assign data, and adjust chart options for your scenario.
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_01_Examples)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Data labels" PageUrl="@pageUrl" Link="data-labels">
    <Block>
        The <strong>Doughnut Chart</strong> component supports data labels, allowing you to display values or category names directly on each segment of the chart.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Enable data labels by configuring the chart's plugin options, such as <code>Options.Plugins.Datalabels.Display = true</code>.</li>
                <li>You can customize the label content, formatting, and position using the available plugin settings.</li>
                <li>Assign your data and labels as usual to the chart's data model.</li>
                <li>Refer to the demo code below for a working example and further configuration options.</li>
            </ol>
        </div>
        Data labels make it easier for users to interpret the chart by showing relevant information directly on each doughnut segment.
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_02_Datalabels)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Click event" PageUrl="@pageUrl" Link="click-event">
    <Block>
        Set the <code>OnClick</code> callback to react when a doughnut segment is selected. The callback receives <code>ChartClickEventArgs</code> with the dataset, item index, label, and raw value; the demo displays the selected item below the chart.
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_03_Click_Event)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Export image" PageUrl="@pageUrl" Link="export-image">
    <Block>
        Export the chart as an image with <code>ToBase64ImageAsync</code>, which returns a base64 data URL you can show, store or send, or save it straight to a file in the browser with <code>DownloadImageAsync</code>.
        If the chart is still animating, both wait for the animation to finish, and the image is streamed from the browser, so Blazor Server needs no larger message size.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Keep a reference to the chart with <code>@@ref</code> and initialize it.</li>
                <li>Call <code>ToBase64ImageAsync()</code> for a PNG data URL, or pass <code>ChartImageType.Jpeg</code> and a quality from 0 to 1.</li>
                <li>Call <code>DownloadImageAsync("doughnut-chart.png")</code> to save the image as a file without sending it to .NET.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_04_Export_Image)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Show and hide slices" PageUrl="@pageUrl" Link="show-and-hide-slices">
    <Block>
        Show and hide single slices from C# and read whether a slice is visible.
        A hidden slice stays hidden when <code>UpdateAsync</code> refreshes the data, even if the slices are re-sorted, because slices are matched by label.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Call <code>ToggleDataVisibilityAsync(index)</code>, or <code>HideAsync(0, index)</code> and <code>ShowAsync(0, index)</code>.</li>
                <li>Read the state with <code>GetDataVisibilityAsync(index)</code>.</li>
                <li>Refresh with <code>UpdateAsync</code>; hidden slices stay hidden.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_05_Show_Hide_Slices)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Legend click event" PageUrl="@pageUrl" Link="legend-click-event">
    <Block>
        Set <code>OnLegendClick</code> to react when a legend item is clicked. On this chart each legend item is a slice, so the callback receives <code>ChartLegendClickEventArgs</code> with the slice <code>Index</code>, the legend text and whether the slice is hidden after the click.
        Set <code>LegendClickToggles="false"</code> to stop the legend from hiding slices, for example to open details instead.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Add an <code>OnLegendClick</code> callback to the chart.</li>
                <li>Keep <code>LegendClickToggles</code> at <code>true</code> for the default hide and show, or set it to <code>false</code> to handle the click yourself.</li>
                <li>Use <code>Index</code>, <code>Text</code> and <code>Hidden</code> from the event arguments.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_06_Legend_Click_Event)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Hover event" PageUrl="@pageUrl" Link="hover-event">
    <Block>
        Set <code>OnHover</code> to react when the pointer moves onto a different slice. The callback receives <code>ChartHoverEventArgs</code> with the same item details as <code>OnClick</code>.
        It is called only when the hovered slice changes, and once with a <code>null</code> <code>DatasetIndex</code> when the pointer leaves all slices, so it does not flood Blazor Server with calls.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Add an <code>OnHover</code> callback to the chart.</li>
                <li>Check <code>DatasetIndex</code>: a value means a slice is hovered; <code>null</code> means the pointer left all slices.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_07_Hover_Event)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Programmatic highlight" PageUrl="@pageUrl" Link="programmatic-highlight">
    <Block>
        Highlight slices and show their tooltip from C# with <code>SetActiveElementsAsync</code>, for example to point at a value from a table next to the chart.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Pass one or more <code>ChartActiveElement(datasetIndex, index)</code> items to <code>SetActiveElementsAsync</code>.</li>
                <li>Pass an empty list to clear the highlight and the tooltip.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_08_Programmatic_Highlight)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Update modes and animation control" PageUrl="@pageUrl" Link="update-modes-and-animation-control">
    <Block>
        Choose how <code>UpdateAsync</code> animates with <code>ChartUpdateMode</code>, and control the running animation with <code>StopAsync</code>, <code>RenderAsync</code>, <code>ResetAsync</code> and <code>ClearAsync</code>.
        These map one-to-one to the Chart.js <code>update(mode)</code>, <code>stop()</code>, <code>render()</code>, <code>reset()</code> and <code>clear()</code> methods.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Call <code>UpdateAsync(data, options)</code> for the default animated update, or pass <code>ChartUpdateMode.None</code> to apply the change at once. An animated update moves each matched dataset from its current values to the new ones, and a new dataset grows in. Datasets are matched by <code>Key</code> when set, otherwise by <code>Label</code>; datasets that share a label, or have none, pair in order.</li>
                <li>Call <code>StopAsync()</code> to end any running animation; the chart stays as it was drawn at that moment. Call <code>UpdateAsync</code> again to animate to new values.</li>
                <li>Call <code>ResetAsync()</code> to put the chart back in its starting state, before its first animation, and <code>RenderAsync()</code> to draw that state. Stop any running animation first, or its next frame draws over the reset. Call <code>ResetAsync()</code> and then <code>UpdateAsync(data, options)</code> to regrow the chart from its starting state, as on first render.</li>
                <li>Call <code>ClearAsync()</code> to clear the canvas; <code>RenderAsync()</code> draws the chart again. A running animation draws over the cleared canvas on its next frame, so stop it first or wait for it to end.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_09_Update_Modes)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Cutout and radius" PageUrl="@pageUrl" Link="cutout-and-radius">
    <Block>
        <code>Cutout</code> sets the size of the hole in the middle and <code>Radius</code> sets the outer radius. Both take pixels or a percentage string; Chart.js uses a <code>"50%"</code> cutout and a <code>"100%"</code> radius for a doughnut chart.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Create <code>DoughnutChartOptions</code> and set <code>Cutout = "75%"</code> for a percentage of the radius.</li>
                <li>Set <code>Cutout = 40</code> to use a fixed hole of 40 pixels, whatever the chart size.</li>
                <li>Set <code>Radius = "80%"</code> to shrink the doughnut inside the available space.</li>
                <li>Pass the options to <code>InitializeAsync</code> or <code>UpdateAsync</code>.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_10_Cutout_And_Radius)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Half gauge" PageUrl="@pageUrl" Link="half-gauge">
    <Block>
        <code>Rotation</code> sets the start angle of the first arc, in degrees from the top, and <code>Circumference</code> sets how far the arcs sweep. Chart.js uses 0 and 360; a rotation of -90 with a circumference of 180 draws a half doughnut, and Chart.js scales it to fill the space.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Rotation = -90</code> and <code>Circumference = 180</code> on <code>DoughnutChartOptions</code> for a half gauge.</li>
                <li>Use other pairs, such as <code>Rotation = -135</code> with <code>Circumference = 270</code>, for a three-quarter dial.</li>
                <li>For a single-value gauge, add two slices (the value and the remainder), give the remainder a grey <code>BackgroundColor</code>, and set <code>Plugins.Legend.Display = false</code>.</li>
                <li>Combine with <code>Cutout</code>, for example <code>"75%"</code>, for a thinner gauge.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_11_Half_Gauge)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Rotate and scale animation" PageUrl="@pageUrl" Link="rotate-and-scale-animation">
    <Block>
        <code>ChartAnimation.AnimateRotate</code> sweeps the arcs in from the start angle, and <code>AnimateScale</code> grows the chart from the center. Chart.js uses <code>true</code> and <code>false</code> for doughnut charts. Click <strong>Replay</strong> to run the first-render animation again.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Animation = new ChartAnimation { AnimateRotate = false, AnimateScale = true }</code> on <code>DoughnutChartOptions</code>.</li>
                <li>Set <code>Duration</code> on the same <code>ChartAnimation</code> to make the animation longer or shorter.</li>
                <li>To replay, call <code>StopAsync()</code>, then <code>ResetAsync()</code>, then <code>UpdateAsync(chartData, options)</code> on each chart.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_12_Rotate_And_Scale_Animation)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Spacing mode" PageUrl="@pageUrl" Link="spacing-mode">
    <Block>
        The dataset <code>Spacing</code> adds a gap between arcs, in pixels, and <code>SpacingMode</code> sets how the gap is measured: <code>"angular"</code> keeps an equal angle (the Chart.js default), <code>"proportional"</code> scales with each arc, and <code>"parallel"</code> keeps the edges of neighbouring arcs parallel.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Spacing = 8</code> on the <code>DoughnutChartDataset</code>.</li>
                <li>Set <code>SpacingMode</code> on the same dataset to <code>"angular"</code>, <code>"proportional"</code> or <code>"parallel"</code>.</li>
                <li>Leave <code>SpacingMode</code> as <code>null</code> to use the Chart.js default.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_13_Spacing_Mode)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Title and subtitle" PageUrl="@pageUrl" Link="title-and-subtitle">
    <Block>
        <code>Plugins.Title</code> and <code>Plugins.Subtitle</code> draw a title and a smaller line of text, placed by <code>Position</code> and aligned by <code>Align</code>. The subtitle is drawn just after the title on the same side. In this library both default to <code>Color = "black"</code>.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Plugins.Title = new ChartPluginsTitle { Display = true, Text = "Browser share" }</code>.</li>
                <li>Set <code>Plugins.Subtitle = new() { Display = true, Text = "Visitors in October" }</code>.</li>
                <li>Use <code>Position</code> (<code>"top"</code>, <code>"left"</code>, <code>"bottom"</code> or <code>"right"</code>) and <code>Align</code> (<code>"start"</code>, <code>"center"</code> or <code>"end"</code>) to place each one.</li>
                <li>Set <code>Padding = new() { Top = 10, Bottom = 30 }</code> for more space, and <code>FullSize = false</code> to keep the title within the chart area instead of the full canvas width.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_14_Title_And_Subtitle)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Tooltip options" PageUrl="@pageUrl" Link="tooltip-options">
    <Block>
        <code>Plugins.Tooltip</code> sets which items the tooltip lists, where it is placed and how it looks. When <code>Mode</code> and <code>Intersect</code> are not set, the tooltip uses the chart <code>Interaction</code> options; with two rings, <code>InteractionMode.Index</code> lists the same slice of both rings.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Plugins.Tooltip = new ChartPluginsTooltip { Mode = InteractionMode.Index, Intersect = true }</code>, or use <code>InteractionMode.Nearest</code> with <code>Intersect = false</code> to show the closest slice even between slices.</li>
                <li>Set <code>Position</code> to <code>"average"</code> or <code>"nearest"</code>.</li>
                <li>Style the box with <code>Padding</code>, <code>CornerRadius</code>, <code>BorderColor</code> and <code>BorderWidth</code>.</li>
                <li>Style the color boxes with <code>BoxWidth</code>, <code>BoxHeight</code>, <code>BoxPadding</code>, <code>UsePointStyle</code> and <code>MultiKeyBackground</code>.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_15_Tooltip_Options)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Layout padding" PageUrl="@pageUrl" Link="layout-padding">
    <Block>
        <code>Layout</code> adds empty space inside the canvas, around the legend, title and chart. The dashed borders show the canvas edges.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Layout.Padding = 20</code> for the same padding on every side, in pixels.</li>
                <li>Set <code>Layout.PaddingSides = new() { Left = 60, Top = 10 }</code> for a value per side; when set, it is sent instead of <code>Padding</code>.</li>
                <li>Leave both unset for no padding.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_16_Layout_Padding)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Aspect ratio and resize delay" PageUrl="@pageUrl" Link="aspect-ratio-and-resize-delay">
    <Block>
        With <code>MaintainAspectRatio = true</code>, the canvas height follows its width by <code>AspectRatio</code> (width / height); Chart.js uses 1 for doughnut charts. <code>ResizeDelay</code> waits the given milliseconds after the container stops resizing before the chart redraws, which saves work while the window is dragged; resize the window to see the wide chart catch up.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Keep <code>MaintainAspectRatio = true</code> (the default) and set <code>AspectRatio</code> to 1, 2 or 3.</li>
                <li>Set <code>ResizeDelay = 300</code> to redraw only after resizing pauses.</li>
                <li>Set <code>DevicePixelRatio = 2</code> to draw the canvas at a higher resolution, for sharper images from <code>ToBase64ImageAsync</code> and <code>DownloadImageAsync</code>.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_17_Aspect_Ratio_And_Resize_Delay)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Hover and elements" PageUrl="@pageUrl" Link="hover-and-elements">
    <Block>
        <code>Elements.Arc</code> sets defaults for every arc, which dataset settings override. <code>Hover</code> sets which slices are highlighted under the pointer, separately from <code>Interaction</code>, which the tooltip keeps using. <code>Events</code> limits the browser events the chart listens to: with <code>Events = ["click"]</code>, moving the pointer does nothing and <code>OnHover</code> does not fire; clicking a slice still highlights it and opens its tooltip, and <code>OnClick</code> fires.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Elements = new ChartElements { Arc = new ChartElementsArc { BorderWidth = 4, BorderAlign = "inner", BorderRadius = 6 } }</code>.</li>
                <li>Set <code>Arc.Circular = false</code> to draw the arcs with straight edges.</li>
                <li>Set <code>Hover = new ChartHover { Mode = InteractionMode.Index, Intersect = true }</code> to highlight the same slice in every ring, and give the datasets a <code>HoverOffset</code> to make the highlight visible.</li>
                <li>Set <code>Events = ["click"]</code> to react to clicks only.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_18_Hover_And_Elements)" Tabs="true" />
</Section>

<Section Class="p-0" Size="HeadingSize.H4" Name="Colors plugin" PageUrl="@pageUrl" Link="colors-plugin">
    <Block>
        The built-in Chart.js colors plugin gives datasets that set no colors a default palette, one color per slice on a doughnut chart. It does nothing when any dataset sets its own colors, unless <code>ForceOverride = true</code>. Line, radar and scatter datasets send a default color, so on those charts the palette needs <code>ForceOverride = true</code>.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Leave <code>BackgroundColor</code> unset on the <code>DoughnutChartDataset</code>.</li>
                <li>Set <code>Plugins.Colors = new() { Enabled = true }</code>, or leave it unset, to use the palette; <code>Enabled = false</code> leaves the slices in the Chart.js default grey.</li>
                <li>Set <code>Plugins.Colors = new() { ForceOverride = true }</code> to replace the colors the dataset sets.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(DoughnutChart_Demo_19_Colors_Plugin)" Tabs="true" />
</Section>

@code {
    private const string pageUrl = DemoRouteConstants.Demos_DoughnutChart;
    private const string pageTitle = "Doughnut Chart";
    private const string pageDescription = "Explore interactive <code>Blazor Doughnut Chart</code> demos with real-world examples. Learn how to visualize data, customize chart options, and implement data labels using the Blazor Doughnut Chart component.";
    private const string metaTitle = "Blazor Doughnut Chart Demo & Examples";
    private const string metaDescription = "Explore interactive Blazor Doughnut Chart demos with real-world examples. Learn how to visualize data, customize chart options, and implement data labels using the Blazor Doughnut Chart component.";
    private const string imageUrl = DemoImageSrcConstants.DoughnutChart;
}

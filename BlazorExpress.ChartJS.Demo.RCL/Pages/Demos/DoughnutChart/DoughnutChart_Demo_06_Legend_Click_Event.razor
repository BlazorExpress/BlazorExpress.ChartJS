<div class="mb-3">
    <label>
        <input type="checkbox" @bind="legendClickToggles" />
        Legend click hides and shows the slice (<code>LegendClickToggles</code>)
    </label>
</div>

<DoughnutChart @ref="doughnutChart" Width="400" LegendClickToggles="legendClickToggles" OnLegendClick="HandleLegendClickAsync" />

@if (legendClicks.Count > 0)
{
    <ul class="mt-3 mb-0">
        @foreach (var legendClick in legendClicks)
        {
            <li>@legendClick</li>
        }
    </ul>
}

@code {
    private DoughnutChart doughnutChart = default!;
    private DoughnutChartOptions doughnutChartOptions = default!;
    private ChartData chartData = default!;
    private bool legendClickToggles = true;
    private readonly List<string> legendClicks = new();

    protected override void OnInitialized()
    {
        chartData = new ChartData
        {
            Labels = new List<string> { "Chrome", "Safari", "Firefox", "Edge" },
            Datasets = new List<IChartDataset>
            {
                new DoughnutChartDataset
                {
                    Label = "Visitors",
                    Data = new List<double?> { 55, 20, 12, 13 },
                    BackgroundColor = new List<string> { "rgb(54, 162, 235)", "rgb(153, 102, 255)", "rgb(255, 159, 64)", "rgb(201, 203, 207)" },
                },
            },
        };
        doughnutChartOptions = new DoughnutChartOptions { Responsive = true };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await doughnutChart.InitializeAsync(chartData, doughnutChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private Task HandleLegendClickAsync(ChartLegendClickEventArgs eventArgs)
    {
        legendClicks.Insert(0, $"{eventArgs.Text} (slice {eventArgs.Index}): hidden = {eventArgs.Hidden}");

        if (legendClicks.Count > 5)
            legendClicks.RemoveAt(legendClicks.Count - 1);

        return Task.CompletedTask;
    }
}

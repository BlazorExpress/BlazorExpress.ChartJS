<div class="columns is-multiline">
    <div class="column is-half">
        <p class="mb-2"><code>Elements.Arc</code>: <code>BorderWidth = 4</code>, <code>BorderAlign = "inner"</code>, <code>BorderRadius = 6</code></p>
        <DoughnutChart @ref="doughnutChart1" />
    </div>
    <div class="column is-half">
        <p class="mb-2"><code>Elements.Arc</code>: <code>Circular = false</code> (straight arc edges)</p>
        <DoughnutChart @ref="doughnutChart2" />
    </div>
    <div class="column is-half">
        <p class="mb-2"><code>Hover = new ChartHover { Mode = InteractionMode.Index }</code>: hovering a slice highlights it in both rings; the tooltip keeps the <code>Interaction</code> mode</p>
        <DoughnutChart @ref="doughnutChart3" />
    </div>
    <div class="column is-half">
        <p class="mb-2"><code>Events = ["click"]</code>: pointer moves do nothing; click a slice to highlight it and see its tooltip</p>
        <DoughnutChart @ref="doughnutChart4" />
    </div>
</div>

@code {
    private DoughnutChart doughnutChart1 = default!;
    private DoughnutChart doughnutChart2 = default!;
    private DoughnutChart doughnutChart3 = default!;
    private DoughnutChart doughnutChart4 = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var borderOptions = new DoughnutChartOptions
            {
                Elements = new ChartElements
                {
                    Arc = new ChartElementsArc { BorderWidth = 4, BorderColor = "rgb(255, 255, 255)", BorderAlign = "inner", BorderRadius = 6 },
                },
            };
            await doughnutChart1.InitializeAsync(CreateChartData(ringCount: 1), borderOptions);

            var straightOptions = new DoughnutChartOptions { Elements = new ChartElements { Arc = new ChartElementsArc { Circular = false } } };
            await doughnutChart2.InitializeAsync(CreateChartData(ringCount: 1), straightOptions);

            var hoverOptions = new DoughnutChartOptions
            {
                Interaction = new Interaction { Mode = InteractionMode.Nearest, Intersect = true },
                Hover = new ChartHover { Mode = InteractionMode.Index, Intersect = true },
            };
            await doughnutChart3.InitializeAsync(CreateChartData(ringCount: 2), hoverOptions);

            await doughnutChart4.InitializeAsync(CreateChartData(ringCount: 1), new DoughnutChartOptions { Events = ["click"] });
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private static ChartData CreateChartData(int ringCount)
    {
        var datasets = new List<IChartDataset>();
        for (var ring = 0; ring < ringCount; ring++)
        {
            datasets.Add(new DoughnutChartDataset
            {
                Label = ring == 0 ? "2024" : "2023",
                Data = ring == 0 ? new List<double?> { 45, 25, 15, 10, 5 } : new List<double?> { 40, 25, 20, 10, 5 },
                BackgroundColor = Enumerable.Range(0, 5).Select(index => ColorUtility.CategoricalTwelveColors[index].ToColor().ToRgbString()).ToList(),
                HoverOffset = new List<double> { 12 },
            });
        }

        return new ChartData { Labels = new List<string> { "Chrome", "Safari", "Firefox", "Edge", "Opera" }, Datasets = datasets };
    }
}

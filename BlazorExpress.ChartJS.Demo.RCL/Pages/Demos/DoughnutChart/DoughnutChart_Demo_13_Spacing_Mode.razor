<div class="columns is-multiline">
    <div class="column is-one-third">
        <p class="mb-2"><code>Spacing = 8</code>, <code>SpacingMode = "angular"</code> (the Chart.js default)</p>
        <DoughnutChart @ref="doughnutChart1" />
    </div>
    <div class="column is-one-third">
        <p class="mb-2"><code>Spacing = 8</code>, <code>SpacingMode = "proportional"</code></p>
        <DoughnutChart @ref="doughnutChart2" />
    </div>
    <div class="column is-one-third">
        <p class="mb-2"><code>Spacing = 8</code>, <code>SpacingMode = "parallel"</code></p>
        <DoughnutChart @ref="doughnutChart3" />
    </div>
</div>

@code {
    private DoughnutChart doughnutChart1 = default!;
    private DoughnutChart doughnutChart2 = default!;
    private DoughnutChart doughnutChart3 = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await doughnutChart1.InitializeAsync(CreateChartData("angular"), new DoughnutChartOptions());
            await doughnutChart2.InitializeAsync(CreateChartData("proportional"), new DoughnutChartOptions());
            await doughnutChart3.InitializeAsync(CreateChartData("parallel"), new DoughnutChartOptions());
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private static ChartData CreateChartData(string spacingMode) =>
        new()
        {
            Labels = new List<string> { "Chrome", "Safari", "Firefox", "Edge", "Opera" },
            Datasets = new List<IChartDataset>
            {
                new DoughnutChartDataset
                {
                    Label = "Visitors",
                    Data = new List<double?> { 45, 25, 15, 10, 5 },
                    BackgroundColor = Enumerable.Range(0, 5).Select(index => ColorUtility.CategoricalTwelveColors[index].ToColor().ToRgbString()).ToList(),
                    Spacing = 8,
                    SpacingMode = spacingMode,
                },
            },
        };
}

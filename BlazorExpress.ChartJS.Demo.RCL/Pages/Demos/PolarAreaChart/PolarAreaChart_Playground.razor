<PlaygroundPanel Code="@csharp">
    <Controls>
        <PlaygroundRange Label="Start angle" Max="360" Step="15" Unit="°" Value="startAngle" ValueChanged="value => SetAsync(() => startAngle = value)" />
        <PlaygroundRange Label="Border width" Max="8" Unit=" px" Value="borderWidth" ValueChanged="value => SetAsync(() => borderWidth = value)" />
        <PlaygroundCheckbox Label="Circular grid" Value="circular" ValueChanged="value => SetAsync(() => circular = value)" />
        <PlaygroundCheckbox Label="Show tick labels" Value="showTicks" ValueChanged="value => SetAsync(() => showTicks = value)" />
        <PlaygroundCommonControls Settings="settings" OnChanged="ApplyAsync" />
    </Controls>
    <Chart>
        <PolarAreaChart @ref="chart" />
    </Chart>
</PlaygroundPanel>

@code {
    // The Chart.js default; a value is listed in the C# only when it differs.
    private const double DefaultBorderWidth = 2;

    private PolarAreaChart chart = default!;
    private readonly PlaygroundSettings settings = new();
    private string csharp = string.Empty;
    private double borderWidth = DefaultBorderWidth;
    private bool circular = true;
    private bool showTicks = true;
    private double startAngle;

    protected override void OnInitialized() => Build();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var (chartData, options) = Build();
            await chart.InitializeAsync(chartData, options);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task ApplyAsync()
    {
        var (chartData, options) = Build();
        await chart.UpdateAsync(chartData, options);
    }

    private async Task SetAsync(Action change)
    {
        change();
        await ApplyAsync();
    }

    // Builds the chart data and options from the controls, and the C# that gives the same chart.
    private (ChartData ChartData, PolarAreaChartOptions Options) Build()
    {
        var text = new PlaygroundCode(nameof(PolarAreaChartOptions), nameof(PolarAreaChartDataset));
        var options = new PolarAreaChartOptions { Responsive = true };
        settings.Apply(options, options.Plugins, text);

        if (startAngle > 0)
        {
            options.Scales.R!.StartAngle = startAngle;
            text.Option("Scales.R!.StartAngle", PlaygroundCode.Literal(startAngle));
        }

        if (!circular)
        {
            options.Scales.R!.Grid = new ChartAxesGrid { Circular = false };
            text.Option("Scales.R!.Grid", "new ChartAxesGrid { Circular = false }");
        }

        if (!showTicks)
        {
            options.Scales.R!.Ticks = new ChartAxesTicks { Display = false };
            text.Option("Scales.R!.Ticks", "new ChartAxesTicks { Display = false }");
        }

        if (borderWidth != DefaultBorderWidth) text.Dataset("BorderWidth", PlaygroundCode.List(borderWidth));

        var chartData = new ChartData
        {
            Labels = ["North", "East", "South", "West", "Central"],
            Datasets =
            [
                new PolarAreaChartDataset
                {
                    Label = "Orders",
                    Data = [11200, 16400, 7300, 9800, 14100],
                    BackgroundColor = Enumerable.Range(0, 5).Select(index => DemoPalette.GetTransparent(index, 0.7)).ToList(),
                    BorderWidth = [borderWidth],
                }
            ]
        };

        csharp = text.ToString();

        return (chartData, options);
    }
}

@attribute [Route(pageUrl)]
@attribute [Route(pageUrl + "/{Sample}")]
@layout DemosMainLayout

<SamplePageHeader ChartKey="@SampleChartKeys.PolarAreaChart" Sample="@Sample">
    <SiteMetaTags PageUrl="@pageUrl" Title="@metaTitle" Description="@metaDescription" ImageUrl="@imageUrl" />

    <PageHero Title="@pageTitle">
        <SubTitleTemplate>
            @((MarkupString)pageDescription)
        </SubTitleTemplate>
    </PageHero>

    <DocsLink Href="@DemoRouteConstants.Docs_PolarAreaChart" />

    <Prerequisites PageUrl="@pageUrl" />
</SamplePageHeader>

@* Each SampleSection renders only on its own sample page, /demos/<chart>/<slug>. *@
<CascadingValue Value="@SampleCatalog.Find(SampleChartKeys.PolarAreaChart, Sample)">
<SampleSection Slug="how-it-works">
    <Block>
        The <strong>Polar Area Chart</strong> component visualizes each data value as a segment with equal angles but varying radius, making it ideal for comparing values across categories in a circular layout.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Add the <code>PolarAreaChart</code> component to your page and set its dimensions (e.g., <code>Width="600"</code>).</li>
                <li>Prepare your chart data by specifying <code>Labels</code> for each category and one or more <code>Datasets</code> with values and background colors.</li>
                <li>Configure chart options such as <code>Responsive</code> and <code>Title</code> using the <code>PolarAreaChartOptions</code> object.</li>
                <li>Initialize the chart in <code>OnAfterRenderAsync</code> by calling <code>polarAreaChart.InitializeAsync(chartData, polarAreaChartOptions)</code>.</li>
                <li>Use the demo's interactive buttons to randomize data, add datasets, or add new data points dynamically and see the chart update in real time.</li>
                <li>Refer to the demo code below for practical examples of data preparation, dynamic updates, and chart customization.</li>
            </ol>
        </div>
        This demo demonstrates how to set up a Polar Area Chart, bind your data, and interactively update the chart to fit your application's needs.
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_01_Examples)" Tabs="true" />
</SampleSection>

<SampleSection Slug="playground">
    <Block>
        Change the main options of a polar area chart and watch the chart and its C# update together. The controls cover start angle, border width, grid shape and tick labels, plus the legend, the locale and right-to-left layout.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Change a control. The chart is updated with <code>UpdateAsync</code>, so it animates from its current state.</li>
                <li>Pick a <strong>Locale</strong> to see how numbers are formatted for that region, and switch on <strong>Right to left</strong> to mirror the legend and tooltip.</li>
                <li>Copy the C# below the chart. It lists only the settings that differ from their defaults, with the property names the library uses.</li>
            </ol>
        </div>
    </Block>
    <PolarAreaChart_Playground />
</SampleSection>

<SampleSection Slug="click-event">
    <Block>
        Set the <code>OnClick</code> callback to react when a polar-area segment is selected. The callback receives <code>ChartClickEventArgs</code> with the dataset, item index, label, and raw value; the demo displays the selected item below the chart.
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_02_Click_Event)" Tabs="true" />
</SampleSection>

<SampleSection Slug="export-image">
    <Block>
        Export the chart as an image with <code>ToBase64ImageAsync</code>, which returns a base64 data URL you can show, store or send, or save it straight to a file in the browser with <code>DownloadImageAsync</code>.
        If the chart is still animating, both wait for the animation to finish, and the image is streamed from the browser, so Blazor Server needs no larger message size.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Keep a reference to the chart with <code>@@ref</code> and initialize it.</li>
                <li>Call <code>ToBase64ImageAsync()</code> for a PNG data URL, or pass <code>ChartImageType.Jpeg</code> and a quality from 0 to 1.</li>
                <li>Call <code>DownloadImageAsync("polar-area-chart.png")</code> to save the image as a file without sending it to .NET.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_03_Export_Image)" Tabs="true" />
</SampleSection>

<SampleSection Slug="show-and-hide-slices">
    <Block>
        Show and hide single slices from C# and read whether a slice is visible.
        A hidden slice stays hidden when <code>UpdateAsync</code> refreshes the data, even if the slices are re-sorted, because slices are matched by label.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Call <code>ToggleDataVisibilityAsync(index)</code>, or <code>HideAsync(0, index)</code> and <code>ShowAsync(0, index)</code>.</li>
                <li>Read the state with <code>GetDataVisibilityAsync(index)</code>.</li>
                <li>Refresh with <code>UpdateAsync</code>; hidden slices stay hidden.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_04_Show_Hide_Slices)" Tabs="true" />
</SampleSection>

<SampleSection Slug="legend-click-event">
    <Block>
        Set <code>OnLegendClick</code> to react when a legend item is clicked. On this chart each legend item is a slice, so the callback receives <code>ChartLegendClickEventArgs</code> with the slice <code>Index</code>, the legend text and whether the slice is hidden after the click.
        Set <code>LegendClickToggles="false"</code> to stop the legend from hiding slices, for example to open details instead.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Add an <code>OnLegendClick</code> callback to the chart.</li>
                <li>Keep <code>LegendClickToggles</code> at <code>true</code> for the default hide and show, or set it to <code>false</code> to handle the click yourself.</li>
                <li>Use <code>Index</code>, <code>Text</code> and <code>Hidden</code> from the event arguments.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_05_Legend_Click_Event)" Tabs="true" />
</SampleSection>

<SampleSection Slug="hover-event">
    <Block>
        Set <code>OnHover</code> to react when the pointer moves onto a different slice. The callback receives <code>ChartHoverEventArgs</code> with the same item details as <code>OnClick</code>.
        It is called only when the hovered slice changes, and once with a <code>null</code> <code>DatasetIndex</code> when the pointer leaves all slices, so it does not flood Blazor Server with calls.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Add an <code>OnHover</code> callback to the chart.</li>
                <li>Check <code>DatasetIndex</code>: a value means a slice is hovered; <code>null</code> means the pointer left all slices.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_06_Hover_Event)" Tabs="true" />
</SampleSection>

<SampleSection Slug="programmatic-highlight">
    <Block>
        Highlight slices and show their tooltip from C# with <code>SetActiveElementsAsync</code>, for example to point at a value from a table next to the chart.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Pass one or more <code>ChartActiveElement(datasetIndex, index)</code> items to <code>SetActiveElementsAsync</code>.</li>
                <li>Pass an empty list to clear the highlight and the tooltip.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_07_Programmatic_Highlight)" Tabs="true" />
</SampleSection>

<SampleSection Slug="update-modes-and-animation-control">
    <Block>
        Choose how <code>UpdateAsync</code> animates with <code>ChartUpdateMode</code>, and control the running animation with <code>StopAsync</code>, <code>RenderAsync</code>, <code>ResetAsync</code> and <code>ClearAsync</code>.
        These map one-to-one to the Chart.js <code>update(mode)</code>, <code>stop()</code>, <code>render()</code>, <code>reset()</code> and <code>clear()</code> methods.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Call <code>UpdateAsync(data, options)</code> for the default animated update, or pass <code>ChartUpdateMode.None</code> to apply the change at once. An animated update moves each matched dataset from its current values to the new ones, and a new dataset grows in. Datasets are matched by <code>Key</code> when set, otherwise by <code>Label</code>; datasets that share a label, or have none, pair in order.</li>
                <li>Call <code>StopAsync()</code> to end any running animation; the chart stays as it was drawn at that moment. Call <code>UpdateAsync</code> again to animate to new values.</li>
                <li>Call <code>ResetAsync()</code> to put the chart back in its starting state, before its first animation, and <code>RenderAsync()</code> to draw that state. Stop any running animation first, or its next frame draws over the reset. Call <code>ResetAsync()</code> and then <code>UpdateAsync(data, options)</code> to regrow the chart from its starting state, as on first render.</li>
                <li>Call <code>ClearAsync()</code> to clear the canvas; <code>RenderAsync()</code> draws the chart again. A running animation draws over the cleared canvas on its next frame, so stop it first or wait for it to end.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_08_Update_Modes)" Tabs="true" />
</SampleSection>

<SampleSection Slug="radial-scale">
    <Block>
        The polar area chart sizes each slice on one radial axis, <code>Scales.R</code>, sent to Chart.js as <code>scales.r</code>. The axis starts at zero by default (<code>BeginAtZero = true</code>), as in Chart.js, and its rings are round.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Scales = new RadialScales { R = new ChartRadialAxes { ... } }</code> on <code>PolarAreaChartOptions</code>.</li>
                <li>Set <code>BeginAtZero = false</code> to start the axis from the data minimum; the smallest slice then has no radius.</li>
                <li>Fix the range with <code>Min</code> and <code>Max</code>, and set the ring spacing with <code>Ticks = new ChartAxesTicks { StepSize = 10, ShowLabelBackdrop = false }</code>.</li>
                <li>Set <code>Grid = new ChartAxesGrid { Circular = false }</code> for polygon rings, and <code>Reverse = true</code> to put the maximum at the center.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_09_Radial_Scale)" Tabs="true" />
</SampleSection>

<SampleSection Slug="angle-lines-and-point-labels">
    <Block>
        Angle lines run from the center outwards between the slices, and point labels name each slice at the edge of the chart. Chart.js hides both on polar area charts by default, so turn them on with <code>Display = true</code>.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Scales.R.PointLabels = new ChartAxesPointLabels { Display = true, CenterPointLabels = true }</code> to label each slice in its middle.</li>
                <li>Set <code>Scales.R.AngleLines = new ChartAxesAngleLines { Display = true }</code>, and style the lines with <code>Color</code>, <code>LineWidth</code> and <code>BorderDash</code> (for example <code>[6, 4]</code>).</li>
                <li>Style the labels with <code>Color</code>, <code>Font = new ChartFont { Size = 14 }</code>, <code>Padding</code>, <code>BackdropColor</code> and <code>BorderRadius</code>.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_10_Angle_Lines_And_Point_Labels)" Tabs="true" />
</SampleSection>

<SampleSection Slug="start-angle">
    <Block>
        <code>Scales.R.StartAngle</code> rotates the slices, in degrees clockwise from the top. Chart.js uses 0, which starts the first slice at the top.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Scales = new RadialScales { R = new ChartRadialAxes { StartAngle = 45 } }</code>.</li>
                <li>Use 0, 45 or 90 (or any angle) to choose where the first slice starts.</li>
                <li>Turn on <code>PointLabels</code> to follow the rotation more easily, as the demo does.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_11_Start_Angle)" Tabs="true" />
</SampleSection>

<SampleSection Slug="spacing-mode">
    <Block>
        <code>SpacingMode</code> sets how Chart.js measures the gap between slices: <code>"angular"</code> keeps an equal angle, <code>"proportional"</code> (the Chart.js default for polar area) scales the gap with each slice, and <code>"parallel"</code> keeps the edges of neighbouring slices parallel.
        The gap itself is set by <code>Spacing</code>, in pixels; without it there is nothing to measure.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Create a <code>PolarAreaChartDataset</code> with per-slice <code>BackgroundColor</code> values.</li>
                <li>Set <code>Spacing</code> on the dataset, for example <code>Spacing = 8</code>, to open a gap between the slices.</li>
                <li>Set <code>SpacingMode</code> to <code>"angular"</code>, <code>"proportional"</code> or <code>"parallel"</code> on the dataset.</li>
                <li>Optionally set <code>BorderColor</code> and <code>BorderWidth</code> per slice to outline the slices.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_12_Spacing_Mode)" Tabs="true" />
</SampleSection>

<SampleSection Slug="title-and-subtitle">
    <Block>
        The title and subtitle plugins draw text around the chart area. Chart.js hides both by default; in this library the title and subtitle color defaults to <code>"black"</code>.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Plugins.Title = new ChartPluginsTitle { Display = true, Text = "Sales by region" }</code>.</li>
                <li>Add <code>Plugins.Subtitle = new() { Display = true, Text = "Q1 2026" }</code>; it is drawn below the title.</li>
                <li>Move either one with <code>Position</code> (<code>"top"</code>, <code>"left"</code>, <code>"bottom"</code>, <code>"right"</code>) and align it with <code>Align</code> (<code>"start"</code>, <code>"center"</code>, <code>"end"</code>).</li>
                <li>Add space with <code>Padding = new ChartPadding { Top = 10, Bottom = 20 }</code>, and set <code>FullSize = false</code> to keep the title within the chart area width.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_13_Title_And_Subtitle)" Tabs="true" />
</SampleSection>

<SampleSection Slug="tooltip-options">
    <Block>
        Tooltip options decide which slices a tooltip lists, where it opens and how it looks. Values left <code>null</code> use the chart's <code>Interaction</code> options and the Chart.js defaults.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Plugins.Tooltip = new() { ... }</code> on <code>PolarAreaChartOptions</code>.</li>
                <li>Set <code>Mode</code> to <code>InteractionMode.Nearest</code> or <code>InteractionMode.Index</code>, and <code>Intersect = false</code> to open the tooltip for the closest slice even when the pointer is outside it.</li>
                <li>Set <code>Position</code> to <code>"average"</code> (the middle of the listed slices) or <code>"nearest"</code> (the point closest to the pointer).</li>
                <li>Style it with <code>Padding</code>, <code>CornerRadius</code>, <code>BorderColor</code>, <code>BorderWidth</code>, <code>BoxWidth</code>, <code>BoxHeight</code>, <code>BoxPadding</code>, <code>UsePointStyle</code> and <code>MultiKeyBackground</code>.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_14_Tooltip_Options)" Tabs="true" />
</SampleSection>

<SampleSection Slug="layout-padding">
    <Block>
        Layout padding adds space between the canvas edge and the chart, legend and title. Chart.js uses no padding by default; the dashed border in the demo shows the canvas edge.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Layout.Padding = 20</code> to add 20 pixels on every side.</li>
                <li>Set <code>Layout.PaddingSides = new() { Left = 60, Top = 10 }</code> for a value per side; when set, it is sent instead of <code>Padding</code>.</li>
                <li>Leave both unset for no padding.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_15_Layout_Padding)" Tabs="true" />
</SampleSection>

<SampleSection Slug="aspect-ratio-and-resize-delay">
    <Block>
        A responsive chart keeps its width-to-height ratio while <code>MaintainAspectRatio</code> is <code>true</code>; Chart.js uses a ratio of 1 for polar area charts. <code>ResizeDelay</code> waits the given milliseconds after the last resize before redrawing, so dragging the window edge causes one redraw instead of many; resize the window to see it.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Keep <code>MaintainAspectRatio = true</code> (the default) and set <code>AspectRatio</code> to 1, 2 or 3.</li>
                <li>Set <code>ResizeDelay = 250</code> to redraw 250 ms after resizing stops.</li>
                <li>Set <code>DevicePixelRatio = 2</code> to draw the canvas at twice the resolution, for sharper exported images.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_16_Aspect_Ratio_And_Resize_Delay)" Tabs="true" />
</SampleSection>

<SampleSection Slug="hover-and-elements">
    <Block>
        <code>Elements</code> sets default styles for every arc the chart draws, and <code>Hover</code> decides which slices are highlighted under the pointer, separately from <code>Interaction</code>, which the tooltip keeps using.
        Values set on the dataset win over <code>Elements</code>; polar area datasets always send <code>Circular = true</code>, so set <code>Circular</code> on the dataset.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Elements = new ChartElements { Arc = new ChartElementsArc { BorderWidth = 6, BorderColor = "#ffffff", BorderAlign = "inner" } }</code>; <code>"inner"</code> keeps the border inside each slice.</li>
                <li>Set <code>Hover = new ChartHover { Mode = InteractionMode.Nearest, Intersect = false }</code> to highlight the closest slice even when the pointer is outside it, while the tooltip still needs the pointer on a slice.</li>
                <li>Set <code>HoverBackgroundColor</code> on the dataset to show the highlight more clearly.</li>
                <li>Set <code>Events = ["click"]</code> to listen to clicks only: moving the pointer does nothing and <code>OnHover</code> does not fire; clicking a slice still highlights it and opens its tooltip, and <code>OnClick</code> fires.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_17_Hover_And_Elements)" Tabs="true" />
</SampleSection>

<SampleSection Slug="colors-plugin">
    <Block>
        The Chart.js colors plugin gives datasets that set no colors a color from its built-in palette; on polar area charts it colors each slice. Polar area datasets send no color unless you set one, so the palette applies without <code>ForceOverride</code>. Line, radar and scatter datasets do send a default color, so there the palette needs <code>ForceOverride = true</code>.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Leave <code>BackgroundColor</code> unset on the dataset and set <code>Plugins.Colors = new() { Enabled = true }</code> to color the slices from the palette.</li>
                <li>Set <code>Enabled = false</code> to turn the plugin off; slices without colors are then drawn in the Chart.js default grey.</li>
                <li>Set <code>ForceOverride = true</code> to replace the colors you set on the dataset with the palette.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(PolarAreaChart_Demo_18_Colors_Plugin)" Tabs="true" />
</SampleSection>
</CascadingValue>

<SamplePageFooter ChartKey="@SampleChartKeys.PolarAreaChart" Sample="@Sample" />

@code {
    /// <summary>The sample slug from the URL, or <see langword="null" /> on the chart overview.</summary>
    [Parameter] public string? Sample { get; set; }

    private const string pageUrl = DemoRouteConstants.Demos_PolarAreaChart;
    private const string pageTitle = "PolarArea Chart";
    private const string pageDescription = "Explore interactive <code>Blazor Polar Area Chart</code> examples with source code. Learn how to visualize categorical data, customize chart appearance, and enhance your Blazor applications. Try live demos and discover practical usage scenarios for the Polar Area Chart component.";
    private const string metaTitle = "Blazor Polar Area Chart Examples";
    private const string metaDescription = "Explore interactive Blazor Polar Area Chart examples with source code. Learn how to visualize categorical data, customize chart appearance, and enhance your Blazor applications. Try live demos and discover practical usage scenarios for the Polar Area Chart component.";
    private const string imageUrl = DemoImageSrcConstants.PolarAreaChart;
}

<div class="columns is-multiline">
    <div class="column is-one-third">
        <p class="is-size-7 has-text-weight-semibold mb-2"><code>Mode = InteractionMode.Nearest</code>, <code>Intersect = true</code>, <code>Position = "average"</code></p>
        <PolarAreaChart @ref="nearestChart" />
    </div>
    <div class="column is-one-third">
        <p class="is-size-7 has-text-weight-semibold mb-2"><code>Mode = InteractionMode.Index</code>, <code>Intersect = false</code>, <code>Position = "nearest"</code></p>
        <PolarAreaChart @ref="indexChart" />
    </div>
    <div class="column is-one-third">
        <p class="is-size-7 has-text-weight-semibold mb-2">Styled: padding, corner radius, border, color boxes, <code>UsePointStyle</code>, <code>MultiKeyBackground</code></p>
        <PolarAreaChart @ref="styledChart" />
    </div>
</div>

@code {
    private PolarAreaChart nearestChart = default!;
    private PolarAreaChart indexChart = default!;
    private PolarAreaChart styledChart = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var nearestOptions = new PolarAreaChartOptions();
            nearestOptions.Plugins.Tooltip = new()
            {
                Mode = InteractionMode.Nearest,
                Intersect = true,
                Position = "average"
            };
            await nearestChart.InitializeAsync(GetChartData(), nearestOptions);

            // Without Intersect, the tooltip opens for the closest slice even when the pointer is outside it.
            var indexOptions = new PolarAreaChartOptions();
            indexOptions.Plugins.Tooltip = new()
            {
                Mode = InteractionMode.Index,
                Intersect = false,
                Position = "nearest"
            };
            await indexChart.InitializeAsync(GetChartData(), indexOptions);

            var styledOptions = new PolarAreaChartOptions();
            styledOptions.Plugins.Tooltip = new()
            {
                Mode = InteractionMode.Nearest,
                Intersect = false,
                Padding = 12,
                CornerRadius = 10,
                BorderColor = ColorUtility.CategoricalTwelveColors[2].ToColor().ToRgbString(),
                BorderWidth = 2,
                BoxWidth = 12,
                BoxHeight = 12,
                BoxPadding = 6,
                UsePointStyle = true,
                MultiKeyBackground = "#e8c600"
            };
            await styledChart.InitializeAsync(GetChartData(), styledOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    #region Data Preparation

    private static ChartData GetChartData() =>
        new()
        {
            Labels = ["North", "East", "South", "West", "Central"],
            Datasets = [CreateDataset([11, 16, 7, 3, 14])]
        };

    private static PolarAreaChartDataset CreateDataset(List<double?> data)
    {
        var backgroundColors = new List<string>();
        var borderColors = new List<string>();

        for (var index = 0; index < data.Count; index++)
        {
            var c = ColorUtility.CategoricalTwelveColors[index].ToColor();
            backgroundColors.Add(c.ToRgbaString(0.5));
            borderColors.Add(c.ToRgbString());
        }

        return new PolarAreaChartDataset
        {
            Label = "Sales",
            Data = data,
            BackgroundColor = backgroundColors,
            BorderColor = borderColors
        };
    }

    #endregion Data Preparation
}

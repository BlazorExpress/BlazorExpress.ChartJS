<PolarAreaChart @ref="polarAreaChart" Width="500" />

<div class="mt-3">
    <button type="button" class="button is-primary is-small" @onclick="ExportPngAsync">Export PNG</button>
    <button type="button" class="button is-info is-small" @onclick="ExportJpegAsync">Export JPEG (quality 0.8)</button>
    <button type="button" class="button is-success is-small" @onclick="DownloadPngAsync">Download PNG</button>
</div>

@if (imageDataUrl is not null)
{
    <p class="mt-3 mb-1">Exported @imageDataUrl.Length characters: <code>@imageDataUrl[..Math.Min(30, imageDataUrl.Length)]...</code></p>
    <img src="@imageDataUrl" alt="Exported polar area chart image" style="max-width: 300px; border: 1px solid #dee2e6;" />
}

@code {
    private PolarAreaChart polarAreaChart = default!;
    private PolarAreaChartOptions polarAreaChartOptions = default!;
    private ChartData chartData = default!;
    private string? imageDataUrl;

    protected override void OnInitialized()
    {
        chartData = new ChartData
        {
            Labels = new List<string> { "North", "South", "East", "West" },
            Datasets = new List<IChartDataset>
            {
                new PolarAreaChartDataset
                {
                    Label = "Sales",
                    Data = new List<double?> { 35, 55, 40, 25 },
                    BackgroundColor = new List<string> { "rgba(54, 162, 235, 0.5)", "rgba(153, 102, 255, 0.5)", "rgba(255, 159, 64, 0.5)", "rgba(201, 203, 207, 0.5)" },
                },
            },
        };
        polarAreaChartOptions = new PolarAreaChartOptions { Responsive = true };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await polarAreaChart.InitializeAsync(chartData, polarAreaChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task DownloadPngAsync() => await polarAreaChart.DownloadImageAsync("polar-area-chart.png");

    private async Task ExportJpegAsync() => imageDataUrl = await polarAreaChart.ToBase64ImageAsync(ChartImageType.Jpeg, 0.8);

    private async Task ExportPngAsync() => imageDataUrl = await polarAreaChart.ToBase64ImageAsync();
}

<BubbleChart @ref="bubbleChart" Width="600" OnLegendClick="UpdateVisibleDatasetCountAsync" />

<div class="mt-3">
    @foreach (var label in datasetLabels)
    {
        <button type="button" class="button is-primary is-small mr-1" @onclick="() => ToggleDatasetAsync(label)">Toggle @label</button>
    }
    <button type="button" class="button is-warning is-small" @onclick="() => bubbleChart.HideAsync(datasetLabels.IndexOf(FirstDataset), PointIndex)">Hide March Projects</button>
    <button type="button" class="button is-info is-small" @onclick="() => bubbleChart.ShowAsync(datasetLabels.IndexOf(FirstDataset), PointIndex)">Show March Projects</button>
    <button type="button" class="button is-success is-small" @onclick="RefreshWithoutAnimationAsync">Refresh data without animation</button>
</div>

<p class="mt-3 mb-0">Visible datasets: @visibleDatasetCount of @datasetLabels.Count</p>

@code {
    private const string FirstDataset = "Projects";
    private const int PointIndex = 2;
    private BubbleChart bubbleChart = default!;
    private BubbleChartOptions bubbleChartOptions = default!;
    private ChartData chartData = default!;
    private readonly List<string> labels = new() { "January", "February", "March", "April" };
    private readonly List<string> datasetLabels = new() { "Projects", "Products", "Campaigns" };
    private readonly Dictionary<string, string> colors = new() { ["Projects"] = "54, 162, 235", ["Products"] = "255, 159, 64", ["Campaigns"] = "75, 192, 192" };
    private int visibleDatasetCount = 3;

    protected override void OnInitialized()
    {
        chartData = CreateChartData();
        bubbleChartOptions = new BubbleChartOptions { Responsive = true };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await bubbleChart.InitializeAsync(chartData, bubbleChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private ChartData CreateChartData() =>
        new()
        {
            Labels = labels,
            Datasets = datasetLabels
                .Select(label => (IChartDataset)new BubbleChartDataset
                {
                    Label = label,
                    Data = labels.Select(_ => new BubbleChartDataPoint(Random.Shared.Next(0, 100), Random.Shared.Next(0, 100), Random.Shared.Next(5, 20))).ToList(),
                    BackgroundColor = new List<string> { $"rgba({colors[label]}, 0.5)" },
                    BorderColor = new List<string> { $"rgb({colors[label]})" },
                    BorderWidth = 1,
                })
                .ToList(),
        };

    // New data objects, in a new order: hidden datasets and bubbles stay hidden because they are matched by label.
    private async Task RefreshWithoutAnimationAsync()
    {
        datasetLabels.Reverse();
        chartData = CreateChartData();
        await bubbleChart.UpdateAsync(chartData, bubbleChartOptions, ChartUpdateMode.None);
        await UpdateVisibleDatasetCountAsync();
    }

    private async Task ToggleDatasetAsync(string label)
    {
        var datasetIndex = datasetLabels.IndexOf(label);
        var isVisible = await bubbleChart.IsDatasetVisibleAsync(datasetIndex);

        if (isVisible)
            await bubbleChart.HideAsync(datasetIndex);
        else
            await bubbleChart.ShowAsync(datasetIndex);

        await UpdateVisibleDatasetCountAsync();
    }

    private async Task UpdateVisibleDatasetCountAsync() => visibleDatasetCount = await bubbleChart.GetVisibleDatasetCountAsync();
}

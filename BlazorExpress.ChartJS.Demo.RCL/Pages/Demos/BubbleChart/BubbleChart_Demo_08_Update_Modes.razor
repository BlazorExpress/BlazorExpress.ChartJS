<BubbleChart @ref="bubbleChart" Width="600" />

<div class="mt-3">
    <button type="button" class="button is-primary is-small" @onclick="RefreshAsync">Refresh (animated)</button>
    <button type="button" class="button is-info is-small" @onclick="RefreshWithoutAnimationAsync">Refresh without animation</button>
    <button type="button" class="button is-success is-small" @onclick="ResetAsync">Reset</button>
    <button type="button" class="button is-warning is-small" @onclick="StopAsync">Stop</button>
    <button type="button" class="button is-link is-small" @onclick="RenderAsync">Render</button>
    <button type="button" class="button is-danger is-small" @onclick="ClearAsync">Clear</button>
</div>

<p class="mt-3 mb-0">@status</p>

@code {
    private BubbleChart bubbleChart = default!;
    private BubbleChartOptions bubbleChartOptions = default!;
    private ChartData chartData = default!;
    private readonly List<string> labels = new() { "January", "February", "March", "April" };
    private readonly Dictionary<string, string> colors = new() { ["Projects"] = "54, 162, 235", ["Products"] = "255, 159, 64" };
    private string status = "Animations take 2 seconds here, so there is time to click Stop.";

    protected override void OnInitialized()
    {
        chartData = CreateChartData();
        bubbleChartOptions = new BubbleChartOptions { Responsive = true, Animation = new ChartAnimation { Duration = 2000 } };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await bubbleChart.InitializeAsync(chartData, bubbleChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task ClearAsync()
    {
        await bubbleChart.ClearAsync();
        status = "Cleared the canvas. Click Render to draw the chart again. While an animation runs, its next frame draws over the cleared canvas, so click Stop first.";
    }

    private ChartData CreateChartData() =>
        new()
        {
            Labels = labels,
            Datasets = colors.Keys
                .Select(label => (IChartDataset)new BubbleChartDataset
                {
                    Label = label,
                    Data = labels.Select(_ => new BubbleChartDataPoint(Random.Shared.Next(0, 100), Random.Shared.Next(0, 100), Random.Shared.Next(5, 20))).ToList(),
                    BackgroundColor = new List<string> { $"rgba({colors[label]}, 0.5)" },
                    BorderColor = new List<string> { $"rgb({colors[label]})" },
                    BorderWidth = 1,
                })
                .ToList(),
        };

    private async Task RefreshAsync()
    {
        chartData = CreateChartData();
        await bubbleChart.UpdateAsync(chartData, bubbleChartOptions);
        status = "Applied new data with the default animation: the chart moved from its current values to the new ones.";
    }

    private async Task RefreshWithoutAnimationAsync()
    {
        chartData = CreateChartData();
        await bubbleChart.UpdateAsync(chartData, bubbleChartOptions, ChartUpdateMode.None);
        status = "Applied new data at once, without animation.";
    }

    private async Task RenderAsync()
    {
        await bubbleChart.RenderAsync();
        status = "Redrew the chart as it is now, for example after Clear.";
    }

    // Stop first: a running animation would draw over the reset state on its next frame.
    private async Task ResetAsync()
    {
        await bubbleChart.StopAsync();
        await bubbleChart.ResetAsync();
        await bubbleChart.RenderAsync();
        status = "Reset the chart to its starting state, before its first animation. Click Refresh (animated) to see the chart regrow from here.";
    }

    private async Task StopAsync()
    {
        await bubbleChart.StopAsync();
        status = "Stopped any running animation. The chart stays as it was drawn at that moment.";
    }
}

<BubbleChart @ref="bubbleChart" Width="600" />

<div class="mt-3">
    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="ExportPngAsync">Export PNG</Button>
    <Button Color="ButtonColor.Info" Size="ButtonSize.Small" @onclick="ExportJpegAsync">Export JPEG (quality 0.8)</Button>
    <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="DownloadPngAsync">Download PNG</Button>
</div>

@if (imageDataUrl is not null)
{
    <p class="mt-3 mb-1">Exported @imageDataUrl.Length characters: <code>@imageDataUrl[..Math.Min(30, imageDataUrl.Length)]...</code></p>
    <img src="@imageDataUrl" alt="Exported bubble chart image" style="max-width: 300px; border: 1px solid #dee2e6;" />
}

@code {
    private BubbleChart bubbleChart = default!;
    private BubbleChartOptions bubbleChartOptions = default!;
    private ChartData chartData = default!;
    private string? imageDataUrl;

    protected override void OnInitialized()
    {
        chartData = new ChartData
        {
            Labels = new List<string> { "January", "February", "March", "April" },
            Datasets = new List<IChartDataset>
            {
                new BubbleChartDataset { Label = "Projects", Data = new List<BubbleChartDataPoint> { new(10, 20, 8), new(15, 12, 12), new(25, 28, 6), new(35, 18, 10) }, BackgroundColor = new List<string> { "rgba(54, 162, 235, 0.5)" }, BorderColor = new List<string> { "rgb(54, 162, 235)" }, BorderWidth = 1 },
                new BubbleChartDataset { Label = "Products", Data = new List<BubbleChartDataPoint> { new(12, 30, 10), new(22, 22, 7), new(30, 10, 14), new(40, 26, 9) }, BackgroundColor = new List<string> { "rgba(255, 159, 64, 0.5)" }, BorderColor = new List<string> { "rgb(255, 159, 64)" }, BorderWidth = 1 },
            },
        };
        bubbleChartOptions = new BubbleChartOptions { Responsive = true };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await bubbleChart.InitializeAsync(chartData, bubbleChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task DownloadPngAsync() => await bubbleChart.DownloadImageAsync("bubble-chart.png");

    private async Task ExportJpegAsync() => imageDataUrl = await bubbleChart.ToBase64ImageAsync(ChartImageType.Jpeg, 0.8);

    private async Task ExportPngAsync() => imageDataUrl = await bubbleChart.ToBase64ImageAsync();
}

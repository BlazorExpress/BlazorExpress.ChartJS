<div class="columns is-multiline">
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">Square: <code>AspectRatio = 1</code></p>
        <BubbleChart @ref="squareChart" />
    </div>
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">Default width: <code>AspectRatio = 2</code>, <code>ResizeDelay = 300</code></p>
        <BubbleChart @ref="defaultRatioChart" />
    </div>
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">Wide: <code>AspectRatio = 3</code>, <code>DevicePixelRatio = 2</code></p>
        <BubbleChart @ref="wideChart" />
    </div>
</div>

@code {
    private BubbleChart squareChart = default!;
    private BubbleChart defaultRatioChart = default!;
    private BubbleChart wideChart = default!;
    private BubbleChartOptions squareOptions = default!;
    private BubbleChartOptions defaultRatioOptions = default!;
    private BubbleChartOptions wideOptions = default!;

    protected override void OnInitialized()
    {
        // AspectRatio (width / height) only applies while MaintainAspectRatio is true (the default)
        squareOptions = new BubbleChartOptions { MaintainAspectRatio = true, AspectRatio = 1 };

        // wait 300 ms after the last resize event before redrawing; resize the window to see it
        defaultRatioOptions = new BubbleChartOptions { MaintainAspectRatio = true, AspectRatio = 2, ResizeDelay = 300 };

        // render at twice the screen resolution for sharper exported images
        wideOptions = new BubbleChartOptions { MaintainAspectRatio = true, AspectRatio = 3, DevicePixelRatio = 2 };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await squareChart.InitializeAsync(GetChartData(), squareOptions);
            await defaultRatioChart.InitializeAsync(GetChartData(), defaultRatioOptions);
            await wideChart.InitializeAsync(GetChartData(), wideOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    #region Data Preparation

    private static ChartData GetChartData() => new()
    {
        Datasets =
        [
            CreateDataset("Group A", 0, [new(5, 12, 8), new(15, 28, 12), new(25, 20, 6), new(35, 42, 15), new(45, 38, 10), new(55, 60, 7), new(65, 52, 14), new(75, 70, 9)]),
            CreateDataset("Group B", 1, [new(10, 40, 14), new(20, 35, 10), new(30, 55, 16), new(40, 48, 7), new(50, 30, 12), new(60, 45, 15), new(70, 25, 8), new(80, 35, 13)])
        ]
    };

    private static BubbleChartDataset CreateDataset(string label, int colorIndex, List<BubbleChartDataPoint> data)
    {
        var c = ColorUtility.CategoricalTwelveColors[colorIndex].ToColor();

        return new BubbleChartDataset
        {
            Label = label,
            Data = data,
            BackgroundColor = [c.ToRgbaString(0.5)],
            BorderColor = [c.ToRgbString()],
            BorderWidth = 2
        };
    }

    #endregion Data Preparation
}

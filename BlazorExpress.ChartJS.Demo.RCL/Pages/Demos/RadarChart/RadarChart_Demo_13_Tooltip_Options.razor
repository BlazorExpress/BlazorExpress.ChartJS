<div class="columns is-multiline">
    <div class="column is-one-third">
        <p class="is-size-7 has-text-weight-semibold mb-2"><code>Mode = InteractionMode.Index</code>, <code>Intersect = false</code>, <code>Position = "average"</code></p>
        <RadarChart @ref="indexChart" />
    </div>
    <div class="column is-one-third">
        <p class="is-size-7 has-text-weight-semibold mb-2"><code>Mode = InteractionMode.Nearest</code>, <code>Intersect = false</code>, <code>Position = "nearest"</code></p>
        <RadarChart @ref="nearestChart" />
    </div>
    <div class="column is-one-third">
        <p class="is-size-7 has-text-weight-semibold mb-2">Styled: padding, corner radius, border, color boxes, <code>UsePointStyle</code>, <code>MultiKeyBackground</code></p>
        <RadarChart @ref="styledChart" />
    </div>
</div>

@code {
    private RadarChart indexChart = default!;
    private RadarChart nearestChart = default!;
    private RadarChart styledChart = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var indexOptions = new RadarChartOptions();
            indexOptions.Plugins.Tooltip = new()
            {
                Mode = InteractionMode.Index,
                Intersect = false,
                Position = "average"
            };
            await indexChart.InitializeAsync(GetChartData(), indexOptions);

            var nearestOptions = new RadarChartOptions();
            nearestOptions.Plugins.Tooltip = new()
            {
                Mode = InteractionMode.Nearest,
                Intersect = false,
                Position = "nearest"
            };
            await nearestChart.InitializeAsync(GetChartData(), nearestOptions);

            var styledOptions = new RadarChartOptions();
            styledOptions.Plugins.Tooltip = new()
            {
                Mode = InteractionMode.Index,
                Intersect = false,
                Padding = 12,
                CornerRadius = 10,
                BorderColor = ColorUtility.CategoricalTwelveColors[2].ToColor().ToRgbString(),
                BorderWidth = 2,
                BoxWidth = 12,
                BoxHeight = 12,
                BoxPadding = 6,
                UsePointStyle = true,
                MultiKeyBackground = "#e8c600"
            };
            await styledChart.InitializeAsync(GetChartData(), styledOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    #region Data Preparation

    private static ChartData GetChartData() =>
        new()
        {
            Labels = ["Speed", "Power", "Defense", "Stamina", "Agility", "Skill"],
            Datasets =
            [
                CreateDataset("Team A", [65, 59, 90, 81, 56, 55], 0),
                CreateDataset("Team B", [28, 48, 40, 19, 96, 27], 1)
            ]
        };

    private static RadarChartDataset CreateDataset(string label, List<double?> data, int colorIndex)
    {
        var c = ColorUtility.CategoricalTwelveColors[colorIndex].ToColor();

        return new RadarChartDataset
        {
            Label = label,
            Data = data,
            BackgroundColor = c.ToRgbaString(0.2),
            BorderColor = c.ToRgbString(),
            BorderWidth = 2,
            Fill = true
        };
    }

    #endregion Data Preparation
}

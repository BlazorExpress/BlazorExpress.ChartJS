<RadarChart @ref="radarChart" Width="600" OnLegendClick="UpdateVisibleDatasetCountAsync" />

<div class="mt-3">
    @foreach (var label in datasetLabels)
    {
        <button type="button" class="button is-primary is-small mr-1" @onclick="() => ToggleDatasetAsync(label)">Toggle @label</button>
    }
    <button type="button" class="button is-warning is-small" @onclick="() => radarChart.HideAsync(datasetLabels.IndexOf(FirstDataset), PointIndex)">Hide Comfort Vehicle A</button>
    <button type="button" class="button is-info is-small" @onclick="() => radarChart.ShowAsync(datasetLabels.IndexOf(FirstDataset), PointIndex)">Show Comfort Vehicle A</button>
    <button type="button" class="button is-success is-small" @onclick="RefreshWithoutAnimationAsync">Refresh data without animation</button>
</div>

<p class="mt-3 mb-0">Visible datasets: @visibleDatasetCount of @datasetLabels.Count</p>

@code {
    private const string FirstDataset = "Vehicle A";
    private const int PointIndex = 2;
    private RadarChart radarChart = default!;
    private RadarChartOptions radarChartOptions = default!;
    private ChartData chartData = default!;
    private readonly List<string> labels = new() { "Speed", "Reliability", "Comfort", "Safety", "Efficiency" };
    private readonly List<string> datasetLabels = new() { "Vehicle A", "Vehicle B", "Vehicle C" };
    private readonly Dictionary<string, string> colors = new() { ["Vehicle A"] = "54, 162, 235", ["Vehicle B"] = "255, 159, 64", ["Vehicle C"] = "75, 192, 192" };
    private int visibleDatasetCount = 3;

    protected override void OnInitialized()
    {
        chartData = CreateChartData();
        radarChartOptions = new RadarChartOptions { Responsive = true };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await radarChart.InitializeAsync(chartData, radarChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private ChartData CreateChartData() =>
        new()
        {
            Labels = labels,
            Datasets = datasetLabels
                .Select(label => (IChartDataset)new RadarChartDataset
                {
                    Label = label,
                    Data = labels.Select(_ => (double?)Random.Shared.Next(40, 100)).ToList(),
                    BackgroundColor = $"rgba({colors[label]}, 0.2)",
                    BorderColor = $"rgb({colors[label]})",
                    BorderWidth = 2,
                    Fill = true,
                })
                .ToList(),
        };

    // New data objects, in a new order: hidden datasets and points stay hidden because they are matched by label.
    private async Task RefreshWithoutAnimationAsync()
    {
        datasetLabels.Reverse();
        chartData = CreateChartData();
        await radarChart.UpdateAsync(chartData, radarChartOptions, ChartUpdateMode.None);
        await UpdateVisibleDatasetCountAsync();
    }

    private async Task ToggleDatasetAsync(string label)
    {
        var datasetIndex = datasetLabels.IndexOf(label);
        var isVisible = await radarChart.IsDatasetVisibleAsync(datasetIndex);

        if (isVisible)
            await radarChart.HideAsync(datasetIndex);
        else
            await radarChart.ShowAsync(datasetIndex);

        await UpdateVisibleDatasetCountAsync();
    }

    private async Task UpdateVisibleDatasetCountAsync() => visibleDatasetCount = await radarChart.GetVisibleDatasetCountAsync();
}

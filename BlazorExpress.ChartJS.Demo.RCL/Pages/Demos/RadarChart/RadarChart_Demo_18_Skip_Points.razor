<div class="columns is-multiline">
    <div class="column is-half">
        <p class="has-text-weight-semibold mb-2">Missing values break the line: <code>SpanGaps = false</code></p>
        <RadarChart @ref="gapsChart" />
    </div>
    <div class="column is-half">
        <p class="has-text-weight-semibold mb-2">Missing values are bridged: <code>SpanGaps = true</code></p>
        <RadarChart @ref="spannedChart" />
    </div>
</div>

@code {
    private RadarChart gapsChart = default!;
    private RadarChart spannedChart = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var options = new RadarChartOptions { Responsive = true };

            await gapsChart.InitializeAsync(GetChartData(spanGaps: false), options);
            await spannedChart.InitializeAsync(GetChartData(spanGaps: true), options);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    // A null value is a skipped point. Each dataset skips a point in a different place: first, middle and last.
    private static ChartData GetChartData(bool spanGaps) =>
        new()
        {
            Labels = ["Speed", "Reliability", "Comfort", "Safety", "Efficiency", "Design"],
            Datasets =
            [
                new RadarChartDataset
                {
                    Label = "Skip first",
                    Data = [null, 72, 64, 81, 58, 69],
                    BorderColor = "rgb(0, 114, 178)", // Okabe–Ito blue
                    BackgroundColor = "rgba(0, 114, 178, 0.2)",
                    SpanGaps = spanGaps,
                },
                new RadarChartDataset
                {
                    Label = "Skip middle",
                    Data = [48, 55, null, 62, 44, 51],
                    BorderColor = "rgb(213, 94, 0)", // Okabe–Ito vermillion
                    BackgroundColor = "rgba(213, 94, 0, 0.2)",
                    SpanGaps = spanGaps,
                },
                new RadarChartDataset
                {
                    Label = "Skip last",
                    Data = [28, 35, 31, 40, 26, null],
                    BorderColor = "rgb(0, 158, 115)", // Okabe–Ito bluish green
                    BackgroundColor = "rgba(0, 158, 115, 0.2)",
                    SpanGaps = spanGaps,
                },
            ]
        };
}

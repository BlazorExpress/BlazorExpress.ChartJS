<div class="columns is-multiline">
    <div class="column is-one-third">
        <p class="is-size-7 has-text-weight-semibold mb-2"><code>AspectRatio = 1</code> (Chart.js default for radar)</p>
        <RadarChart @ref="squareChart" />
    </div>
    <div class="column is-one-third">
        <p class="is-size-7 has-text-weight-semibold mb-2"><code>AspectRatio = 2</code>, <code>ResizeDelay = 250</code></p>
        <RadarChart @ref="wideChart" />
    </div>
    <div class="column is-one-third">
        <p class="is-size-7 has-text-weight-semibold mb-2"><code>AspectRatio = 3</code></p>
        <RadarChart @ref="extraWideChart" />
    </div>
</div>

@code {
    private RadarChart squareChart = default!;
    private RadarChart wideChart = default!;
    private RadarChart extraWideChart = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await squareChart.InitializeAsync(GetChartData(), new RadarChartOptions { MaintainAspectRatio = true, AspectRatio = 1 });

            // ResizeDelay waits 250 ms after the last resize before redrawing; resize the window to see it.
            await wideChart.InitializeAsync(GetChartData(), new RadarChartOptions { MaintainAspectRatio = true, AspectRatio = 2, ResizeDelay = 250 });

            await extraWideChart.InitializeAsync(GetChartData(), new RadarChartOptions { MaintainAspectRatio = true, AspectRatio = 3 });
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    #region Data Preparation

    private static ChartData GetChartData() =>
        new()
        {
            Labels = ["Speed", "Power", "Defense", "Stamina", "Agility", "Skill"],
            Datasets =
            [
                CreateDataset("Team A", [65, 59, 90, 81, 56, 55], 0),
                CreateDataset("Team B", [28, 48, 40, 19, 96, 27], 1)
            ]
        };

    private static RadarChartDataset CreateDataset(string label, List<double?> data, int colorIndex)
    {
        var c = ColorUtility.CategoricalTwelveColors[colorIndex].ToColor();

        return new RadarChartDataset
        {
            Label = label,
            Data = data,
            BackgroundColor = c.ToRgbaString(0.2),
            BorderColor = c.ToRgbString(),
            BorderWidth = 2,
            Fill = true
        };
    }

    #endregion Data Preparation
}

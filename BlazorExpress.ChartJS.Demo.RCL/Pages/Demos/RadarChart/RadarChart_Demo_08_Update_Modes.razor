<RadarChart @ref="radarChart" Width="600" />

<div class="mt-3">
    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="RefreshAsync">Refresh (animated)</Button>
    <Button Color="ButtonColor.Info" Size="ButtonSize.Small" @onclick="RefreshWithoutAnimationAsync">Refresh without animation</Button>
    <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="ResetAsync">Reset</Button>
    <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="StopAsync">Stop</Button>
    <Button Color="ButtonColor.Link" Size="ButtonSize.Small" @onclick="RenderAsync">Render</Button>
    <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="ClearAsync">Clear</Button>
</div>

<p class="mt-3 mb-0">@status</p>

@code {
    private RadarChart radarChart = default!;
    private RadarChartOptions radarChartOptions = default!;
    private ChartData chartData = default!;
    private readonly List<string> labels = new() { "Speed", "Reliability", "Comfort", "Safety", "Efficiency" };
    private readonly Dictionary<string, string> colors = new() { ["Vehicle A"] = "54, 162, 235", ["Vehicle B"] = "255, 159, 64" };
    private string status = "Animations take 2 seconds here, so there is time to click Stop.";

    protected override void OnInitialized()
    {
        chartData = CreateChartData();
        radarChartOptions = new RadarChartOptions { Responsive = true, Animation = new ChartAnimation { Duration = 2000 } };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await radarChart.InitializeAsync(chartData, radarChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task ClearAsync()
    {
        await radarChart.ClearAsync();
        status = "Cleared the canvas. Click Render to draw the chart again. While an animation runs, its next frame draws over the cleared canvas, so click Stop first.";
    }

    private ChartData CreateChartData() =>
        new()
        {
            Labels = labels,
            Datasets = colors.Keys
                .Select(label => (IChartDataset)new RadarChartDataset
                {
                    Label = label,
                    Data = labels.Select(_ => (double?)Random.Shared.Next(40, 100)).ToList(),
                    BackgroundColor = $"rgba({colors[label]}, 0.2)",
                    BorderColor = $"rgb({colors[label]})",
                    BorderWidth = 2,
                    Fill = true,
                })
                .ToList(),
        };

    private async Task RefreshAsync()
    {
        chartData = CreateChartData();
        await radarChart.UpdateAsync(chartData, radarChartOptions);
        status = "Applied new data with the default animation: the chart moved from its current values to the new ones.";
    }

    private async Task RefreshWithoutAnimationAsync()
    {
        chartData = CreateChartData();
        await radarChart.UpdateAsync(chartData, radarChartOptions, ChartUpdateMode.None);
        status = "Applied new data at once, without animation.";
    }

    private async Task RenderAsync()
    {
        await radarChart.RenderAsync();
        status = "Redrew the chart as it is now, for example after Clear.";
    }

    // Stop first: a running animation would draw over the reset state on its next frame.
    private async Task ResetAsync()
    {
        await radarChart.StopAsync();
        await radarChart.ResetAsync();
        await radarChart.RenderAsync();
        status = "Reset the chart to its starting state, before its first animation. Click Refresh (animated) to see the chart regrow from here.";
    }

    private async Task StopAsync()
    {
        await radarChart.StopAsync();
        status = "Stopped any running animation. The chart stays as it was drawn at that moment.";
    }
}

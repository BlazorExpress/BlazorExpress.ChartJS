<ScatterChart role="img" aria-label="Scatter chart: Show and hide datasets" @ref="scatterChart" Width="600" OnLegendClick="UpdateVisibleDatasetCountAsync" />

<div class="mt-3">
    @foreach (var label in datasetLabels)
    {
        <button type="button" class="button is-primary is-small mr-1" @onclick="() => ToggleDatasetAsync(label)">Toggle @label</button>
    }
    <button type="button" class="button is-warning is-small" @onclick="() => scatterChart.HideAsync(datasetLabels.IndexOf(FirstDataset), PointIndex)">Hide North greenhouse at 14:00</button>
    <button type="button" class="button is-info is-small" @onclick="() => scatterChart.ShowAsync(datasetLabels.IndexOf(FirstDataset), PointIndex)">Show North greenhouse at 14:00</button>
    <button type="button" class="button is-success is-small" @onclick="RefreshWithoutAnimationAsync">Refresh data without animation</button>
</div>

<p class="mt-3 mb-0">Visible datasets: @visibleDatasetCount of @datasetLabels.Count</p>

@code {
    private const string FirstDataset = "North greenhouse";
    private const int PointIndex = 2;
    private ScatterChart scatterChart = default!;
    private ScatterChartOptions scatterChartOptions = default!;
    private ChartData chartData = default!;
    private readonly List<string> labels = new() { "06:00", "10:00", "14:00", "18:00" };
    private readonly List<string> datasetLabels = new() { "North greenhouse", "South greenhouse", "East greenhouse" };
    private readonly Dictionary<string, string> colors = new() { ["North greenhouse"] = "54, 162, 235", ["South greenhouse"] = "255, 159, 64", ["East greenhouse"] = "75, 192, 192" };
    private int visibleDatasetCount = 3;

    protected override void OnInitialized()
    {
        chartData = CreateChartData();
        scatterChartOptions = new ScatterChartOptions { Responsive = true };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await scatterChart.InitializeAsync(chartData, scatterChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private ChartData CreateChartData() =>
        new()
        {
            Labels = labels,
            Datasets = datasetLabels
                .Select(label => (IChartDataset)new ScatterChartDataset
                {
                    Label = label,
                    // x = temperature (°C), y = relative humidity (%), one reading at each time of day
                    Data = labels.Select(_ => new ScatterChartDataPoint(Random.Shared.Next(15, 32), Random.Shared.Next(45, 81))).ToList(),
                    BackgroundColor = $"rgba({colors[label]}, 0.6)",
                    BorderColor = $"rgb({colors[label]})",
                    BorderWidth = 2,
                })
                .ToList(),
        };

    // New data objects, in a new order: hidden datasets and points stay hidden because they are matched by label.
    private async Task RefreshWithoutAnimationAsync()
    {
        datasetLabels.Reverse();
        chartData = CreateChartData();
        await scatterChart.UpdateAsync(chartData, scatterChartOptions, ChartUpdateMode.None);
        await UpdateVisibleDatasetCountAsync();
    }

    private async Task ToggleDatasetAsync(string label)
    {
        var datasetIndex = datasetLabels.IndexOf(label);
        var isVisible = await scatterChart.IsDatasetVisibleAsync(datasetIndex);

        if (isVisible)
            await scatterChart.HideAsync(datasetIndex);
        else
            await scatterChart.ShowAsync(datasetIndex);

        await UpdateVisibleDatasetCountAsync();
    }

    private async Task UpdateVisibleDatasetCountAsync() => visibleDatasetCount = await scatterChart.GetVisibleDatasetCountAsync();
}

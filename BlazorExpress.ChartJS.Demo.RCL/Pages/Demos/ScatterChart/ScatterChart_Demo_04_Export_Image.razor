<ScatterChart @ref="scatterChart" Width="600" />

<div class="mt-3">
    <button type="button" class="button is-primary is-small" @onclick="ExportPngAsync">Export PNG</button>
    <button type="button" class="button is-info is-small" @onclick="ExportJpegAsync">Export JPEG (quality 0.8)</button>
    <button type="button" class="button is-success is-small" @onclick="DownloadPngAsync">Download PNG</button>
</div>

@if (imageDataUrl is not null)
{
    <p class="mt-3 mb-1">Exported @imageDataUrl.Length characters: <code>@imageDataUrl[..Math.Min(30, imageDataUrl.Length)]...</code></p>
    <img src="@imageDataUrl" alt="Exported scatter chart image" style="max-width: 300px; border: 1px solid #dee2e6;" />
}

@code {
    private ScatterChart scatterChart = default!;
    private ScatterChartOptions scatterChartOptions = default!;
    private ChartData chartData = default!;
    private string? imageDataUrl;

    protected override void OnInitialized()
    {
        chartData = new ChartData
        {
            Labels = new List<string> { "First", "Second", "Third", "Fourth" },
            Datasets = new List<IChartDataset>
            {
                new ScatterChartDataset { Label = "Sensor A", Data = new List<ScatterChartDataPoint> { new(10, 25), new(25, 15), new(35, 40), new(50, 30) }, BackgroundColor = "rgba(54, 162, 235, 0.6)", BorderColor = "rgb(54, 162, 235)", BorderWidth = 2 },
                new ScatterChartDataset { Label = "Sensor B", Data = new List<ScatterChartDataPoint> { new(15, 45), new(30, 35), new(45, 20), new(60, 50) }, BackgroundColor = "rgba(255, 159, 64, 0.6)", BorderColor = "rgb(255, 159, 64)", BorderWidth = 2 },
            },
        };
        scatterChartOptions = new ScatterChartOptions { Responsive = true };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await scatterChart.InitializeAsync(chartData, scatterChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task DownloadPngAsync() => await scatterChart.DownloadImageAsync("scatter-chart.png");

    private async Task ExportJpegAsync() => imageDataUrl = await scatterChart.ToBase64ImageAsync(ChartImageType.Jpeg, 0.8);

    private async Task ExportPngAsync() => imageDataUrl = await scatterChart.ToBase64ImageAsync();
}

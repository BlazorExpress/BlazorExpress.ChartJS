<div class="columns is-multiline">
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">Point defaults: <code>Elements.Point</code> with <code>Radius</code>, <code>PointStyle</code>, <code>HoverRadius</code>, <code>HoverBorderWidth</code></p>
        <ScatterChart @ref="elementsChart" />
    </div>
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">Hover a whole dataset: <code>Hover = new ChartHover { Mode = InteractionMode.Dataset }</code></p>
        <ScatterChart @ref="hoverChart" />
    </div>
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">Click only: <code>Events = ["click"]</code> (pointer moves do nothing; click a point)</p>
        <ScatterChart @ref="clickOnlyChart" />
    </div>
</div>

@code {
    private ScatterChart elementsChart = default!;
    private ScatterChart hoverChart = default!;
    private ScatterChart clickOnlyChart = default!;
    private ScatterChartOptions elementsOptions = default!;
    private ScatterChartOptions hoverOptions = default!;
    private ScatterChartOptions clickOnlyOptions = default!;

    protected override void OnInitialized()
    {
        // defaults for every point; a dataset value such as PointRadius wins over them
        elementsOptions = new ScatterChartOptions
        {
            Elements = new ChartElements
            {
                Point = new ChartElementsPoint { Radius = 6, PointStyle = "rectRot", HoverRadius = 10, HoverBorderWidth = 3 }
            }
        };

        // hover highlights every point of the dataset, while the tooltip still follows Interaction (nearest point)
        hoverOptions = new ScatterChartOptions
        {
            Elements = new ChartElements { Point = new ChartElementsPoint { Radius = 4, HoverRadius = 8 } },
            Hover = new ChartHover { Mode = InteractionMode.Dataset, Intersect = true }
        };

        // only click events reach the chart: moving the pointer does nothing and OnHover does not fire; a click still highlights the item, opens its tooltip and fires OnClick
        clickOnlyOptions = new ScatterChartOptions
        {
            Elements = new ChartElements { Point = new ChartElementsPoint { Radius = 4, HoverRadius = 8 } },
            Events = ["click"]
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await elementsChart.InitializeAsync(GetChartData(), elementsOptions);
            await hoverChart.InitializeAsync(GetChartData(), hoverOptions);
            await clickOnlyChart.InitializeAsync(GetChartData(), clickOnlyOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    #region Data Preparation

    private static ChartData GetChartData() => new()
    {
        Datasets =
        [
            CreateDataset("Group A", 0, [new(5, 12), new(15, 28), new(25, 20), new(35, 42), new(45, 38), new(55, 60), new(65, 52), new(75, 70)]),
            CreateDataset("Group B", 1, [new(10, 40), new(20, 35), new(30, 55), new(40, 48), new(50, 30), new(60, 45), new(70, 25), new(80, 35)])
        ]
    };

    private static ScatterChartDataset CreateDataset(string label, int colorIndex, List<ScatterChartDataPoint> data)
    {
        var c = ColorUtility.CategoricalTwelveColors[colorIndex].ToColor();

        return new ScatterChartDataset
        {
            Label = label,
            Data = data,
            BackgroundColor = c.ToRgbaString(0.5),
            BorderColor = c.ToRgbString(),
            BorderWidth = 2
        };
    }

    #endregion Data Preparation
}

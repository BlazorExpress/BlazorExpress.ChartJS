<div class="columns is-multiline">
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">Square: <code>AspectRatio = 1</code></p>
        <ScatterChart role="img" aria-label="Scatter chart: study hours against exam score, drawn square" @ref="squareChart" />
    </div>
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">Default width: <code>AspectRatio = 2</code>, <code>ResizeDelay = 300</code></p>
        <ScatterChart role="img" aria-label="Scatter chart: study hours against exam score, twice as wide as tall" @ref="defaultRatioChart" />
    </div>
    <div class="column is-one-third">
        <p class="has-text-weight-semibold mb-2">Wide: <code>AspectRatio = 3</code>, <code>DevicePixelRatio = 2</code></p>
        <ScatterChart role="img" aria-label="Scatter chart: study hours against exam score, three times as wide as tall" @ref="wideChart" />
    </div>
</div>

@code {
    private ScatterChart squareChart = default!;
    private ScatterChart defaultRatioChart = default!;
    private ScatterChart wideChart = default!;
    private ScatterChartOptions squareOptions = default!;
    private ScatterChartOptions defaultRatioOptions = default!;
    private ScatterChartOptions wideOptions = default!;

    protected override void OnInitialized()
    {
        // AspectRatio (width / height) only applies while MaintainAspectRatio is true (the default)
        squareOptions = new ScatterChartOptions { MaintainAspectRatio = true, AspectRatio = 1 };

        // wait 300 ms after the last resize event before redrawing; resize the window to see it
        defaultRatioOptions = new ScatterChartOptions { MaintainAspectRatio = true, AspectRatio = 2, ResizeDelay = 300 };

        // render at twice the screen resolution for sharper exported images
        wideOptions = new ScatterChartOptions { MaintainAspectRatio = true, AspectRatio = 3, DevicePixelRatio = 2 };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await squareChart.InitializeAsync(GetChartData(), squareOptions);
            await defaultRatioChart.InitializeAsync(GetChartData(), defaultRatioOptions);
            await wideChart.InitializeAsync(GetChartData(), wideOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    #region Data Preparation

    private static ChartData GetChartData() => new()
    {
        // x = hours of study, y = exam score (%), one point per student
        Datasets =
        [
            CreateDataset("Class A", 0, [new(1, 52), new(2, 58), new(3, 61), new(4, 70), new(5, 68), new(6, 77), new(7, 84), new(8, 88)]),
            CreateDataset("Class B", 1, [new(1, 45), new(2, 55), new(3, 50), new(4, 63), new(5, 72), new(6, 70), new(7, 79), new(8, 92)])
        ]
    };

    private static ScatterChartDataset CreateDataset(string label, int colorIndex, List<ScatterChartDataPoint> data)
    {
        var c = ColorUtility.CategoricalTwelveColors[colorIndex].ToColor();

        return new ScatterChartDataset
        {
            Label = label,
            Data = data,
            BackgroundColor = c.ToRgbaString(0.5),
            BorderColor = c.ToRgbString(),
            BorderWidth = 2
        };
    }

    #endregion Data Preparation
}

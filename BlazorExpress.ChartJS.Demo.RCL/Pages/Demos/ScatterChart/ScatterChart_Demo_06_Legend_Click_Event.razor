<div class="mb-3">
    <label>
        <input type="checkbox" @bind="legendClickToggles" />
        Legend click hides and shows the dataset (<code>LegendClickToggles</code>)
    </label>
</div>

<ScatterChart role="img" aria-label="Scatter chart: Legend click event" @ref="scatterChart" Width="600" LegendClickToggles="legendClickToggles" OnLegendClick="HandleLegendClickAsync" />

@if (legendClicks.Count > 0)
{
    <ul class="mt-3 mb-0">
        @foreach (var legendClick in legendClicks)
        {
            <li>@legendClick</li>
        }
    </ul>
}

@code {
    private ScatterChart scatterChart = default!;
    private ScatterChartOptions scatterChartOptions = default!;
    private ChartData chartData = default!;
    private bool legendClickToggles = true;
    private readonly List<string> legendClicks = new();

    protected override void OnInitialized()
    {
        chartData = new ChartData
        {
            // x = temperature (°C), y = relative humidity (%), one reading at each time of day
            Labels = new List<string> { "06:00", "10:00", "14:00", "18:00" },
            Datasets = new List<IChartDataset>
            {
                new ScatterChartDataset { Label = "North greenhouse", Data = new List<ScatterChartDataPoint> { new(16, 78), new(22, 66), new(27, 52), new(21, 61) }, BackgroundColor = "rgba(54, 162, 235, 0.6)", BorderColor = "rgb(54, 162, 235)", BorderWidth = 2 },
                new ScatterChartDataset { Label = "South greenhouse", Data = new List<ScatterChartDataPoint> { new(18, 74), new(25, 60), new(31, 45), new(24, 55) }, BackgroundColor = "rgba(255, 159, 64, 0.6)", BorderColor = "rgb(255, 159, 64)", BorderWidth = 2 },
            },
        };
        scatterChartOptions = new ScatterChartOptions { Responsive = true };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await scatterChart.InitializeAsync(chartData, scatterChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    private Task HandleLegendClickAsync(ChartLegendClickEventArgs eventArgs)
    {
        legendClicks.Insert(0, $"{eventArgs.Text} (dataset {eventArgs.DatasetIndex}): hidden = {eventArgs.Hidden}");

        if (legendClicks.Count > 5)
            legendClicks.RemoveAt(legendClicks.Count - 1);

        return Task.CompletedTask;
    }
}

@attribute [Route(pageUrl)]
@attribute [Route(pageUrl + "/{Sample}")]
@layout DemosMainLayout

<SamplePageHeader ChartKey="@SampleChartKeys.ScatterChart" Sample="@Sample">
    <PageMetaTags PageUrl="@pageUrl" Title="@metaTitle" Description="@metaDescription" ImageUrl="@imageUrl" />

    <PageHero Title="@pageTitle">
        <SubTitleTemplate>
            @((MarkupString)pageDescription)
        </SubTitleTemplate>
    </PageHero>

    <DocsLink Href="@DemoRouteConstants.Docs_ScatterChart" />

    <Prerequisites PageUrl="@pageUrl" />
</SamplePageHeader>

@* Each SampleSection renders only on its own sample page, /demos/<chart>/<slug>. *@
<CascadingValue Value="@SampleCatalog.Find(SampleChartKeys.ScatterChart, Sample)">
<SampleSection Slug="how-it-works">
    <Block>
        The <strong>Scatter Chart</strong> component visualizes individual data points as (X, Y) coordinates, making it ideal for displaying relationships or distributions between two numeric variables.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Add the <code>ScatterChart</code> component to your page and set its dimensions (e.g., <code>Width="560"</code>, <code>Height="480"</code>).</li>
                <li>Prepare your chart data by creating one or more <code>ScatterChartDataset</code> objects, each containing a list of <code>ScatterChartDataPoint</code> instances with X and Y values.</li>
                <li>Customize the appearance of each dataset using properties like <code>BackgroundColor</code>, <code>BorderColor</code>, and <code>BorderWidth</code>.</li>
                <li>Configure chart options using the <code>ScatterChartOptions</code> object as needed.</li>
                <li>Initialize the chart in <code>OnAfterRenderAsync</code> by calling <code>scatterChart.InitializeAsync(chartData, scatterChartOptions)</code>.</li>
                <li>Refer to the demo code below for practical examples of data preparation, dataset customization, and chart initialization.</li>
            </ol>
        </div>
        This demo shows how to set up a scatter chart, bind your data, and customize the chart's appearance to fit your application's needs.
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_01_Examples)" Tabs="true" />
</SampleSection>

<SampleSection Slug="playground">
    <Block>
        Change the main options of a scatter chart and watch the chart and its C# update together. The controls cover point style, point radius, zero baseline and grid, plus the legend, the locale and right-to-left layout.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Change a control. The chart is updated with <code>UpdateAsync</code>, so it animates from its current state.</li>
                <li>Pick a <strong>Locale</strong> to see how numbers are formatted for that region, and switch on <strong>Right to left</strong> to mirror the legend and tooltip.</li>
                <li>Copy the C# below the chart. It lists only the settings that differ from their defaults, with the property names the library uses.</li>
            </ol>
        </div>
    </Block>
    <ScatterChart_Playground />
</SampleSection>

<SampleSection Slug="dynamic-data">
    <Block>
        The <strong>Scatter Chart</strong> component supports dynamic data updates, allowing you to add, remove, or modify data points and datasets at runtime. This is useful for visualizing real-time data or enabling interactive data exploration.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Add the <code>ScatterChart</code> component to your page and set its <code>Width</code> and <code>Height</code> as needed.</li>
                <li>Prepare your chart data using one or more <code>ScatterChartDataset</code> objects, each containing a list of <code>ScatterChartDataPoint</code> (with X and Y values).</li>
                <li>Implement methods to update your data dynamically, such as adding new points, randomizing values, or modifying existing datasets.</li>
                <li>After updating the data, call <code>scatterChart.UpdateAsync(chartData, scatterChartOptions)</code> to refresh the chart and reflect the changes.</li>
                <li>Refer to the demo code below for practical examples of dynamic data manipulation and chart updates in a Blazor application.</li>
            </ol>
        </div>
        This demo demonstrates how to work with dynamic data in a scatter chart, enabling interactive and real-time data visualizations in your Blazor projects.
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_02_Dynamic_Data)" Tabs="true" />
</SampleSection>

<SampleSection Slug="click-event">
    <Block>
        Set the <code>OnClick</code> callback to react when a scatter point is selected. The callback receives <code>ChartClickEventArgs</code> with the dataset, point index, and raw coordinates; the demo displays the selected item below the chart.
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_03_Click_Event)" Tabs="true" />
</SampleSection>

<SampleSection Slug="export-image">
    <Block>
        Export the chart as an image with <code>ToBase64ImageAsync</code>, which returns a base64 data URL you can show, store or send, or save it straight to a file in the browser with <code>DownloadImageAsync</code>.
        If the chart is still animating, both wait for the animation to finish, and the image is streamed from the browser, so Blazor Server needs no larger message size.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Keep a reference to the chart with <code>@@ref</code> and initialize it.</li>
                <li>Call <code>ToBase64ImageAsync()</code> for a PNG data URL, or pass <code>ChartImageType.Jpeg</code> and a quality from 0 to 1.</li>
                <li>Call <code>DownloadImageAsync("scatter-chart.png")</code> to save the image as a file without sending it to .NET.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_04_Export_Image)" Tabs="true" />
</SampleSection>

<SampleSection Slug="show-and-hide-datasets">
    <Block>
        Show and hide whole datasets or single points from C#, check whether a dataset is visible and count the visible datasets.
        Visibility changed at runtime, from C# or a legend click, stays in place when <code>UpdateAsync</code> refreshes the data, because datasets are matched by <code>Key</code>, or else by label, and points by label.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Call <code>HideAsync(datasetIndex)</code> and <code>ShowAsync(datasetIndex)</code>, or <code>SetDatasetVisibilityAsync(datasetIndex, visible)</code>.</li>
                <li>Pass a data index too, for example <code>HideAsync(0, 2)</code>, to hide one point.</li>
                <li>Read the state with <code>IsDatasetVisibleAsync</code> and <code>GetVisibleDatasetCountAsync</code>.</li>
                <li>Refresh with <code>UpdateAsync(data, options, ChartUpdateMode.None)</code> to apply new data without animation; hidden datasets and points stay hidden.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_05_Show_Hide_Datasets)" Tabs="true" />
</SampleSection>

<SampleSection Slug="legend-click-event">
    <Block>
        Set <code>OnLegendClick</code> to react when a legend item is clicked. The callback receives <code>ChartLegendClickEventArgs</code> with the dataset index, the legend text and whether the dataset is hidden after the click.
        Set <code>LegendClickToggles="false"</code> to stop the legend from hiding datasets, for example to open details instead.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Add an <code>OnLegendClick</code> callback to the chart.</li>
                <li>Keep <code>LegendClickToggles</code> at <code>true</code> for the default hide and show, or set it to <code>false</code> to handle the click yourself.</li>
                <li>Use <code>DatasetIndex</code>, <code>Text</code> and <code>Hidden</code> from the event arguments.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_06_Legend_Click_Event)" Tabs="true" />
</SampleSection>

<SampleSection Slug="hover-event">
    <Block>
        Set <code>OnHover</code> to react when the pointer moves onto a different point. The callback receives <code>ChartHoverEventArgs</code> with the same item details as <code>OnClick</code>.
        It is called only when the hovered point changes, and once with a <code>null</code> <code>DatasetIndex</code> when the pointer leaves all points, so it does not flood Blazor Server with calls.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Add an <code>OnHover</code> callback to the chart.</li>
                <li>Check <code>DatasetIndex</code>: a value means a point is hovered; <code>null</code> means the pointer left all points.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_07_Hover_Event)" Tabs="true" />
</SampleSection>

<SampleSection Slug="programmatic-highlight">
    <Block>
        Highlight points and show their tooltip from C# with <code>SetActiveElementsAsync</code>, for example to point at a value from a table next to the chart.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Pass one or more <code>ChartActiveElement(datasetIndex, index)</code> items to <code>SetActiveElementsAsync</code>.</li>
                <li>Pass an empty list to clear the highlight and the tooltip.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_08_Programmatic_Highlight)" Tabs="true" />
</SampleSection>

<SampleSection Slug="update-modes-and-animation-control">
    <Block>
        Choose how <code>UpdateAsync</code> animates with <code>ChartUpdateMode</code>, and control the running animation with <code>StopAsync</code>, <code>RenderAsync</code>, <code>ResetAsync</code> and <code>ClearAsync</code>.
        These map one-to-one to the Chart.js <code>update(mode)</code>, <code>stop()</code>, <code>render()</code>, <code>reset()</code> and <code>clear()</code> methods.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Call <code>UpdateAsync(data, options)</code> for the default animated update, or pass <code>ChartUpdateMode.None</code> to apply the change at once. An animated update moves each matched dataset from its current values to the new ones, and a new dataset grows in. Datasets are matched by <code>Key</code> when set, otherwise by <code>Label</code>; datasets that share a label, or have none, pair in order.</li>
                <li>Call <code>StopAsync()</code> to end any running animation; the chart stays as it was drawn at that moment. Call <code>UpdateAsync</code> again to animate to new values.</li>
                <li>Call <code>ResetAsync()</code> to put the chart back in its starting state, before its first animation, and <code>RenderAsync()</code> to draw that state. Stop any running animation first, or its next frame draws over the reset. Call <code>ResetAsync()</code> and then <code>UpdateAsync(data, options)</code> to regrow the chart from its starting state, as on first render.</li>
                <li>Call <code>ClearAsync()</code> to clear the canvas; <code>RenderAsync()</code> draws the chart again. A running animation draws over the cleared canvas on its next frame, so stop it first or wait for it to end.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_09_Update_Modes)" Tabs="true" />
</SampleSection>

<SampleSection Slug="multiple-axes">
    <Block>
        Add a second y-axis or x-axis with <code>Scales.AdditionalAxes</code> and point a dataset at it with <code>YAxisID</code> or <code>XAxisID</code>, so two series with different units share one chart.
        Chart.js lays out each axis on its <code>Position</code>; turn off the extra axis's grid with <code>DrawOnChartArea = false</code> so only one set of grid lines is drawn. Like every axis in this library, an additional axis starts at zero by default (<code>BeginAtZero = true</code>).
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Scales.AdditionalAxes = new() { ["y1"] = new ChartAxes { ... } }</code>; an ID that starts with <code>x</code> or <code>y</code> sets the axis direction.</li>
                <li>Give the axis <code>Type = ChartAxesType.Linear</code> and <code>Position = "right"</code> (or <code>"top"</code> for an <code>x1</code> axis).</li>
                <li>Set <code>Grid = new ChartAxesGrid { DrawOnChartArea = false }</code> on the extra axis.</li>
                <li>Set <code>YAxisID = "y1"</code> (or <code>XAxisID = "x1"</code>) on the <code>ScatterChartDataset</code> that uses it.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_10_Multiple_Axes)" Tabs="true" />
</SampleSection>

<SampleSection Slug="axis-position-and-reverse">
    <Block>
        Move an axis to another edge with <code>Position</code>, flip its direction with <code>Reverse</code>, or hide it with <code>Display = false</code>.
        Chart.js draws the x-axis at the bottom and the y-axis on the left by default; a hidden axis still scales the data, it only stops drawing its ticks, title and grid.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Scales.X.Position = "top"</code> and <code>Scales.Y.Position = "right"</code>.</li>
                <li>Set <code>Scales.Y.Reverse = true</code> to put the largest value at the bottom.</li>
                <li>Set <code>Scales.X.Display = false</code> to hide the x-axis.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_11_Axis_Position_And_Reverse)" Tabs="true" />
</SampleSection>

<SampleSection Slug="tick-options">
    <Block>
        Control how many tick labels a linear axis shows, how they are spaced and how they look with <code>ChartAxesTicks</code>.
        Chart.js picks round step sizes on its own; <code>StepSize</code> and <code>Count</code> override that, and <code>MaxTicksLimit</code> and <code>Precision</code> only limit it.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Scales.Y.Ticks = new ChartAxesTicks { StepSize = 5 }</code> for a fixed step, or <code>Count = 5</code> for a fixed number of ticks.</li>
                <li>Limit labels with <code>MaxTicksLimit</code> and round them with <code>Precision</code>.</li>
                <li>Rotate x labels with <code>MinRotation</code> and <code>MaxRotation</code>, and set <code>AutoSkip = false</code> to keep every label.</li>
                <li>Style and place labels with <code>Font</code>, <code>Color</code>, <code>CrossAlign</code>, <code>Mirror</code> (y labels inside the chart area) and <code>LabelOffset</code>.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_12_Tick_Options)" Tabs="true" />
</SampleSection>

<SampleSection Slug="axis-title">
    <Block>
        Label each axis with <code>ChartAxesTitle</code>. Chart.js hides axis titles by default; in this library the title <code>Color</code> defaults to <code>"black"</code> and its <code>Font</code> to bold 12px.
        The demo sets <code>BeginAtZero = false</code> because axes in this library start at zero by default and the heights and weights are far from zero.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Scales.X.Title = new ChartAxesTitle { Display = true, Text = "Height (cm)" }</code>, and the same for <code>Scales.Y</code>.</li>
                <li>Style it with <code>Color</code> and <code>Font = new ChartFont { Size = 16, Style = "italic" }</code>.</li>
                <li>Add space with <code>Padding = 10</code>, or on one side with <code>Padding = new() { Top = 8 }</code>.</li>
                <li>Align it along the axis with <code>TitleAlignment = TitleAlignment.Start</code> or <code>TitleAlignment.End</code>.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_13_Axis_Title)" Tabs="true" />
</SampleSection>

<SampleSection Slug="grace-and-bounds">
    <Block>
        Add room beyond the data with <code>Grace</code>, choose whether the axis ends at the data or at a whole tick with <code>Bounds</code>, and stack two axes on one edge with <code>Stack</code>.
        Chart.js uses <code>Bounds = "ticks"</code> for linear axes; <code>SuggestedMin</code> and <code>SuggestedMax</code> widen the range only when the data does not reach them. Axes in this library start at zero by default, so the demo sets <code>BeginAtZero = false</code> to show grace and bounds at both ends.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Grace = "10%"</code> (a share of half the data range, measured from the middle to each end) or <code>Grace = 5</code> (axis units).</li>
                <li>Set <code>Bounds = "data"</code> or <code>Bounds = "ticks"</code>, and <code>SuggestedMin</code>/<code>SuggestedMax</code> for a preferred range.</li>
                <li>To stack axes, give <code>Scales.Y</code> and an additional axis <code>y2</code> the same <code>Position</code> and <code>Stack = "demo"</code>, and split the height with <code>StackWeight</code>.</li>
                <li>Set <code>Offset = true</code> for extra space at both ends of an axis, and <code>YAxisID = "y2"</code> on the dataset that uses it.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_14_Grace_And_Bounds)" Tabs="true" />
</SampleSection>

<SampleSection Slug="title-and-subtitle">
    <Block>
        Show a chart title with <code>Plugins.Title</code> and a second line with <code>Plugins.Subtitle</code>. Both are hidden until <code>Display = true</code>, and in this library their <code>Color</code> defaults to <code>"black"</code>.
        Chart.js draws the subtitle just below the title and places both at the top, centered, unless <code>Position</code> or <code>Align</code> says otherwise.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Plugins.Title = new ChartPluginsTitle { Display = true, Text = "..." }</code>.</li>
                <li>Set <code>Plugins.Subtitle = new ChartPluginsSubtitle { Display = true, Text = "..." }</code>.</li>
                <li>Move them with <code>Position</code> (<code>"top"</code>, <code>"left"</code>, <code>"bottom"</code>, <code>"right"</code>) and <code>Align</code> (<code>"start"</code>, <code>"center"</code>, <code>"end"</code>).</li>
                <li>Add space with <code>Padding</code>, and set <code>FullSize = false</code> to keep the title within the chart area.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_15_Title_And_Subtitle)" Tabs="true" />
</SampleSection>

<SampleSection Slug="tooltip-options">
    <Block>
        Choose which points a tooltip lists and how it looks with <code>Plugins.Tooltip</code>. Tooltip <code>Mode</code> and <code>Intersect</code> override the chart <code>Interaction</code> for the tooltip only.
        In a scatter chart, <code>InteractionMode.Index</code> lists the point at the same position in every dataset, and <code>InteractionMode.Nearest</code> lists only the closest point.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Plugins.Tooltip = new ChartPluginsTooltip { Mode = InteractionMode.Index, Intersect = false }</code>.</li>
                <li>Set <code>Position = "average"</code> (Chart.js default) or <code>"nearest"</code> to place the tooltip.</li>
                <li>Style it with <code>Padding</code>, <code>CornerRadius</code>, <code>BorderColor</code> and <code>BorderWidth</code>.</li>
                <li>Size the color boxes with <code>BoxWidth</code>, <code>BoxHeight</code> and <code>BoxPadding</code>, set <code>MultiKeyBackground</code>, or show the point style with <code>UsePointStyle = true</code>.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_16_Tooltip_Options)" Tabs="true" />
</SampleSection>

<SampleSection Slug="layout-padding">
    <Block>
        Add empty space between the canvas edge and the chart with <code>Layout</code>. Chart.js applies it inside the canvas, around the legend, title and axes; the dashed borders in the demo show the canvas edge.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Leave <code>Layout.Padding</code> at <code>0</code> for no padding.</li>
                <li>Set <code>Layout.Padding = 20</code> for the same padding on every side.</li>
                <li>Set <code>Layout.PaddingSides = new() { Left = 60, Top = 10 }</code> for padding per side; when set, it is sent instead of <code>Padding</code>.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_17_Layout_Padding)" Tabs="true" />
</SampleSection>

<SampleSection Slug="aspect-ratio-and-resize-delay">
    <Block>
        Set the width-to-height ratio of a responsive chart with <code>AspectRatio</code>; Chart.js keeps it while <code>MaintainAspectRatio = true</code> (the default) and uses 2 for scatter charts.
        <code>ResizeDelay</code> waits the given milliseconds after the container stops resizing before the chart redraws, which saves work while the window is dragged; resize the window to see the middle chart catch up later.
        <code>DevicePixelRatio</code> renders the canvas at a higher resolution, for sharper exported images.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Keep <code>MaintainAspectRatio = true</code> and set <code>AspectRatio</code> to <code>1</code>, <code>2</code> or <code>3</code>.</li>
                <li>Set <code>ResizeDelay = 300</code> to debounce redraws on resize.</li>
                <li>Set <code>DevicePixelRatio = 2</code> before calling <code>ToBase64ImageAsync</code> or <code>DownloadImageAsync</code> for a sharper image.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_18_Aspect_Ratio_And_Resize_Delay)" Tabs="true" />
</SampleSection>

<SampleSection Slug="hover-and-elements">
    <Block>
        Set default point styling for every dataset with <code>Elements.Point</code>, and change what the pointer highlights with <code>Hover</code>. Dataset values such as <code>PointRadius</code> win over the element defaults.
        <code>Hover</code> overrides <code>Interaction</code> for highlighting only, so the tooltip can still show one point while the whole dataset lights up. With <code>Events = ["click"]</code>, moving the pointer does nothing and <code>OnHover</code> does not fire; clicking a point still highlights it and opens its tooltip, and <code>OnClick</code> fires.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>Elements = new ChartElements { Point = new ChartElementsPoint { Radius = 6, PointStyle = "rectRot", HoverRadius = 10 } }</code>.</li>
                <li>Set <code>Hover = new ChartHover { Mode = InteractionMode.Dataset, Intersect = true }</code> to highlight a whole dataset.</li>
                <li>Set <code>Events = ["click"]</code> to react to clicks only.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_19_Hover_And_Elements)" Tabs="true" />
</SampleSection>

<SampleSection Slug="colors-plugin">
    <Block>
        The Chart.js colors plugin gives datasets without colors a color from its built-in palette. Configure it with <code>Plugins.Colors</code>.
        Line, radar and scatter datasets in this library always send a default color (<code>ScatterChartDataset.BackgroundColor</code> and <code>BorderColor</code> are <code>"rgba(0, 0, 0, 0.1)"</code>), so the plugin leaves them gray unless <code>ForceOverride = true</code>, which replaces dataset colors with the palette.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>BackgroundColor</code> and <code>BorderColor</code> on each <code>ScatterChartDataset</code> for your own colors.</li>
                <li>Set <code>Plugins.Colors = new ChartPluginsColors { Enabled = true }</code> to turn the plugin on (or <code>Enabled = false</code> to turn it off).</li>
                <li>Add <code>ForceOverride = true</code> to apply the palette to scatter datasets.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_20_Colors_Plugin)" Tabs="true" />
</SampleSection>

<SampleSection Slug="time-sensor-readings">
    <Block>
        A scatter chart can plot points against a <strong>time axis</strong>, each point at its own date and time, without any extra script.
        <br /><br />
        <strong>How to use:</strong>
        <div class="content">
            <ol>
                <li>Set <code>TimeData</code> on each <code>ScatterChartDataset</code> to a list of <code>new ChartTimePoint(date, value)</code>.</li>
                <li>Set <code>Scales.X = new ChartAxes { Type = ChartAxesType.Time }</code> with a <code>Time.Unit</code> and .NET date formats.</li>
                <li>Points given as <code>DateTimeOffset</code> or UTC <code>DateTime</code> are exact instants, shown in each viewer's local time.</li>
            </ol>
        </div>
    </Block>
    <Demo Type="typeof(ScatterChart_Demo_21_Time_Sensor_Readings)" Tabs="true" />
</SampleSection>
</CascadingValue>

<SamplePageFooter ChartKey="@SampleChartKeys.ScatterChart" Sample="@Sample" />

@code {
    /// <summary>The sample slug from the URL, or <see langword="null" /> on the chart overview.</summary>
    [Parameter] public string? Sample { get; set; }

    private const string pageUrl = DemoRouteConstants.Demos_ScatterChart;
    private const string pageTitle = "Scatter Chart";
    private const string pageDescription = "The <code>Blazor Scatter Chart</code> component displays data values as vertical bars, making it easy to compare multiple data sets or visualize trends over time.";
    private const string metaTitle = "Blazor Scatter Chart";
    private const string metaDescription = "The Blazor Scatter Chart component displays data values as vertical bars, making it easy to compare multiple data sets or visualize trends over time.";
    private const string imageUrl = DemoImageSrcConstants.ScatterChart;
}

<ScatterChart role="img" aria-label="Scatter chart: delivery time against distance for each delivery zone, updated as deliveries and zones are added" @ref="scatterChart" />

<div class="mt-5">
    <button type="button" class="button is-primary is-small" @onclick="RandomizeAsync"> Randomize </button>
    <button type="button" class="button is-link is-small" @onclick="AddZoneAsync"> Add zone </button>
    <button type="button" class="button is-info is-small" @onclick="AddDeliveryAsync"> Add delivery </button>
</div>

@code {
    private ScatterChart scatterChart = default!;
    private ScatterChartOptions scatterChartOptions = default!;
    private ChartData chartData = default!;

    private static readonly string[] zoneNames = ["North zone", "South zone", "East zone", "West zone", "City centre", "Airport"];
    private readonly Random random = new();
    private int zonesCount;
    private int deliveriesCount;

    protected override void OnInitialized()
    {
        // each zone starts with six deliveries; a scatter chart needs no labels
        deliveriesCount = 6;
        var datasets = Enumerable.Range(0, 3).Select(_ => (IChartDataset)CreateZoneDataset()).ToList();
        chartData = new ChartData { Datasets = datasets };

        scatterChartOptions = new ScatterChartOptions { Responsive = true };
        // null keeps Chart.js's theme-aware default text colour
        scatterChartOptions.Scales.X!.Title = new ChartAxesTitle { Display = true, Text = "Distance (km)", Color = null };
        scatterChartOptions.Scales.Y!.Title = new ChartAxesTitle { Display = true, Text = "Delivery time (minutes)", Color = null };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await scatterChart.InitializeAsync(chartData, scatterChartOptions);

        await base.OnAfterRenderAsync(firstRender);
    }

    // replace every point with a new delivery, then redraw
    private async Task RandomizeAsync()
    {
        foreach (var dataset in chartData.Datasets!.OfType<ScatterChartDataset>())
            dataset.Data = Enumerable.Range(0, dataset.Data!.Count).Select(_ => GetRandomDelivery()).ToList();

        await scatterChart.UpdateAsync(chartData, scatterChartOptions);
    }

    // add a whole dataset: one more delivery zone
    private async Task AddZoneAsync()
    {
        if (zonesCount >= zoneNames.Length)
            return;

        chartData = await scatterChart.AddDatasetAsync(chartData, CreateZoneDataset(), scatterChartOptions);
    }

    // add one point to every zone
    private async Task AddDeliveryAsync()
    {
        var data = chartData.Datasets!
            .OfType<ScatterChartDataset>()
            .Select(dataset => (IChartDatasetData)new ScatterChartDatasetData(dataset.Label, GetRandomDelivery()))
            .ToList();

        deliveriesCount += 1;
        // each point goes to the zone its data names; a scatter chart does not use the label argument
        chartData = await scatterChart.AddDataAsync(chartData, string.Empty, data);
    }

    #region Data Preparation

    private ScatterChartDataset CreateZoneDataset()
    {
        var c = ColorUtility.CategoricalTwelveColors[zonesCount].ToColor();
        var label = zoneNames[zonesCount];
        zonesCount += 1;

        return new ScatterChartDataset
        {
            Label = label,
            Data = Enumerable.Range(0, deliveriesCount).Select(_ => GetRandomDelivery()).ToList(),
            BackgroundColor = c.ToRgbaString(0.5),
            BorderColor = c.ToRgbString(),
            BorderWidth = 2,
        };
    }

    // a delivery 1 to 20 km away takes about 10 minutes plus 3 minutes per km, give or take traffic
    private ScatterChartDataPoint GetRandomDelivery()
    {
        var distance = Math.Round(1 + random.NextDouble() * 19, 1);
        var minutes = Math.Round(10 + distance * 3 + random.Next(-6, 12));
        return new ScatterChartDataPoint(distance, minutes);
    }

    #endregion Data Preparation
}

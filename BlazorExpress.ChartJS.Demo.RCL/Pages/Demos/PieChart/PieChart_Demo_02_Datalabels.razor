<PieChart role="img" aria-label="Pie chart: revenue by sales channel in thousands of dollars, one ring per year from 2023 to 2025, with each value printed on its slice" @ref="pieChart" Width="600" />

@code {
    private PieChart pieChart = default!;
    private PieChartOptions pieChartOptions = default!;
    private ChartData chartData = default!;

    protected override void OnInitialized()
    {
        var colors = ColorUtility.CategoricalTwelveColors.Take(4).ToList();

        chartData = new ChartData
        {
            Labels = new List<string> { "Online store", "Retail stores", "Wholesale", "Marketplaces" },
            Datasets = new List<IChartDataset>
            {
                // Each dataset is one ring, the first one outermost. Datalabels.Anchor places the labels of a ring
                // at the outer edge (End), the middle (Center) or the inner edge (Start) of each slice.
                // Alignment = Start then moves an End label from the outer edge back into its segment, so it stays on the canvas.
                new PieChartDataset { Label = "2023 revenue ($k)", Data = new List<double?> { 180, 320, 140, 60 }, BackgroundColor = colors, Datalabels = new() { Anchor = DataLabelAnchor.End, Alignment = DataLabelAlignment.Start } },
                new PieChartDataset { Label = "2024 revenue ($k)", Data = new List<double?> { 240, 300, 150, 90 }, BackgroundColor = colors, Datalabels = new() { Anchor = DataLabelAnchor.Center } },
                new PieChartDataset { Label = "2025 revenue ($k)", Data = new List<double?> { 310, 280, 160, 130 }, BackgroundColor = colors, Datalabels = new() { Anchor = DataLabelAnchor.End, Alignment = DataLabelAlignment.Start } },
            },
        };

        pieChartOptions = new PieChartOptions { Responsive = true };
        // null keeps Chart.js's theme-aware default text colour
        pieChartOptions.Plugins.Title = new ChartPluginsTitle { Display = true, Text = "Revenue by sales channel, 2023 (outer ring) to 2025 (inner ring)", Color = null };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Pass the plugin name to turn on the data labels.
            await pieChart.InitializeAsync(chartData: chartData, chartOptions: pieChartOptions, plugins: new string[] { "ChartDataLabels" });
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}

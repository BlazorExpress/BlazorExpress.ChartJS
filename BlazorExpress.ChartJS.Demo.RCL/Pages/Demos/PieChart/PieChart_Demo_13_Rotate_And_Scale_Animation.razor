<div class="columns is-multiline">
    <div class="column is-one-third">
        <p class="mb-2"><code>AnimateRotate = true</code>, <code>AnimateScale = false</code> (the Chart.js default)</p>
        <PieChart @ref="pieChart1" />
    </div>
    <div class="column is-one-third">
        <p class="mb-2"><code>AnimateRotate = false</code>, <code>AnimateScale = true</code></p>
        <PieChart @ref="pieChart2" />
    </div>
    <div class="column is-one-third">
        <p class="mb-2"><code>AnimateRotate = true</code>, <code>AnimateScale = true</code></p>
        <PieChart @ref="pieChart3" />
    </div>
</div>

<div class="mt-3">
    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="ReplayAsync">Replay</Button>
</div>

@code {
    private PieChart pieChart1 = default!;
    private PieChart pieChart2 = default!;
    private PieChart pieChart3 = default!;

    private ChartData chartData1 = default!;
    private ChartData chartData2 = default!;
    private ChartData chartData3 = default!;

    private PieChartOptions pieChartOptions1 = default!;
    private PieChartOptions pieChartOptions2 = default!;
    private PieChartOptions pieChartOptions3 = default!;

    protected override void OnInitialized()
    {
        chartData1 = CreateChartData();
        chartData2 = CreateChartData();
        chartData3 = CreateChartData();

        pieChartOptions1 = new PieChartOptions { Animation = new ChartAnimation { AnimateRotate = true, AnimateScale = false, Duration = 1500 } };
        pieChartOptions2 = new PieChartOptions { Animation = new ChartAnimation { AnimateRotate = false, AnimateScale = true, Duration = 1500 } };
        pieChartOptions3 = new PieChartOptions { Animation = new ChartAnimation { AnimateRotate = true, AnimateScale = true, Duration = 1500 } };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await pieChart1.InitializeAsync(chartData1, pieChartOptions1);
            await pieChart2.InitializeAsync(chartData2, pieChartOptions2);
            await pieChart3.InitializeAsync(chartData3, pieChartOptions3);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task ReplayAsync()
    {
        await ReplayChartAsync(pieChart1, chartData1, pieChartOptions1);
        await ReplayChartAsync(pieChart2, chartData2, pieChartOptions2);
        await ReplayChartAsync(pieChart3, chartData3, pieChartOptions3);
    }

    // Stop first: a running animation would draw over the reset state on its next frame.
    private static async Task ReplayChartAsync(PieChart chart, ChartData chartData, PieChartOptions options)
    {
        await chart.StopAsync();
        await chart.ResetAsync();
        await chart.UpdateAsync(chartData, options);
    }

    private static ChartData CreateChartData() =>
        new()
        {
            Labels = new List<string> { "Chrome", "Safari", "Firefox", "Edge", "Opera" },
            Datasets = new List<IChartDataset>
            {
                new PieChartDataset
                {
                    Label = "Visitors",
                    Data = new List<double?> { 45, 25, 15, 10, 5 },
                    BackgroundColor = Enumerable.Range(0, 5).Select(index => ColorUtility.CategoricalTwelveColors[index].ToColor().ToRgbString()).ToList(),
                },
            },
        };
}

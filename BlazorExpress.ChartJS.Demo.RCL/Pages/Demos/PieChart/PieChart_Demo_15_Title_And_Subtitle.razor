<div class="columns is-multiline">
    <div class="column is-one-third">
        <p class="mb-2">Title and subtitle on top (<code>Position = "top"</code>)</p>
        <PieChart role="img" aria-label="Pie chart: browser share of visitors in October, title and subtitle on top" @ref="pieChart1" />
    </div>
    <div class="column is-one-third">
        <p class="mb-2">Title <code>Position = "left"</code>, subtitle <code>Position = "bottom"</code></p>
        <PieChart role="img" aria-label="Pie chart: browser share of visitors in October, title on the left, subtitle below" @ref="pieChart2" />
    </div>
    <div class="column is-one-third">
        <p class="mb-2"><code>Align = "start"</code>, extra <code>Padding</code>, <code>FullSize = false</code> beside a left legend</p>
        <PieChart role="img" aria-label="Pie chart: browser share of visitors in October, start-aligned title, legend on the left" @ref="pieChart3" />
    </div>
</div>

@code {
    private PieChart pieChart1 = default!;
    private PieChart pieChart2 = default!;
    private PieChart pieChart3 = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var topOptions = new PieChartOptions();
            // null keeps Chart.js's theme-aware default text colour
            topOptions.Plugins.Title = new ChartPluginsTitle { Display = true, Text = "Browser share", Color = null, Position = "top", Font = new ChartFont { Size = 16 } };
            topOptions.Plugins.Subtitle = new ChartPluginsSubtitle { Display = true, Text = "Visitors in October", Color = null };
            await pieChart1.InitializeAsync(CreateChartData(), topOptions);

            var sideOptions = new PieChartOptions();
            sideOptions.Plugins.Title = new ChartPluginsTitle { Display = true, Text = "Browser share", Color = null, Position = "left" };
            sideOptions.Plugins.Subtitle = new ChartPluginsSubtitle { Display = true, Text = "Visitors in October", Color = null, Position = "bottom" };
            await pieChart2.InitializeAsync(CreateChartData(), sideOptions);

            var startOptions = new PieChartOptions();
            startOptions.Plugins.Legend.Position = "left";
            startOptions.Plugins.Title = new ChartPluginsTitle
            {
                Display = true,
                Text = "Browser share",
                Color = null,
                Align = "start",
                Padding = new() { Top = 10, Bottom = 30 },
                FullSize = false,
            };
            startOptions.Plugins.Subtitle = new ChartPluginsSubtitle { Display = true, Text = "Visitors in October", Color = null, Align = "start" };
            await pieChart3.InitializeAsync(CreateChartData(), startOptions);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private static ChartData CreateChartData() =>
        new()
        {
            Labels = new List<string> { "Chrome", "Safari", "Firefox", "Edge", "Opera" },
            Datasets = new List<IChartDataset>
            {
                new PieChartDataset
                {
                    Label = "Visitors",
                    Data = new List<double?> { 45, 25, 15, 10, 5 },
                    BackgroundColor = Enumerable.Range(0, 5).Select(index => ColorUtility.CategoricalTwelveColors[index].ToColor().ToRgbString()).ToList(),
                },
            },
        };
}

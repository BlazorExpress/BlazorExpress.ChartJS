@namespace BlazorExpress.ChartJS.Demo.RCL
@attribute [Route(pageUrl)]
@layout MainLayout
@implements IDisposable
@inject NavigationManager NavigationManager

@* The router renders this page for any unknown URL (App.razor: Router NotFoundPage). Redesigned in QF-26112001 with the
   home page palette: a centered card with the 404 mark, the missing address, two actions and three places to go next. *@
<SiteMetaTags PageUrl="@pageUrl" Title="Page Not Found" Description="There is no page at this address." Robots="noindex" />

<div class="be-not-found container is-max-desktop">
    <section class="be-not-found-card" aria-labelledby="be-not-found-title">
        <p class="be-not-found-code" aria-hidden="true">404</p>
        <h1 id="be-not-found-title" class="be-not-found-title">Page not found</h1>
        <p class="be-not-found-lead">Sorry, there's nothing at this address. The page may have moved, or the link may be mistyped.</p>
        @if (requestedPath is not null)
        {
            @* The path comes from the URL; Razor writes it as text. *@
            <p class="be-not-found-path"><span class="is-sr-only">Requested address: </span><code>@requestedPath</code></p>
        }
        <div class="buttons is-centered be-home-actions be-not-found-actions">
            <a class="button is-medium be-home-btn-primary" href="@DemoRouteConstants.Home_Prefix">Go to the home page</a>
            <a class="button is-medium be-home-btn-secondary" href="@DemoRouteConstants.Demos_Samples">Browse the samples</a>
        </div>
    </section>

    <section class="be-not-found-next" aria-labelledby="be-not-found-next-title">
        <h2 id="be-not-found-next-title" class="be-not-found-next-title">Try one of these instead</h2>
        <div class="be-not-found-links">
            <a class="be-not-found-link" href="@DemoRouteConstants.Docs_Getting_Started_Introduction">
                <i class="bi bi-file-text-fill" aria-hidden="true"></i>
                <span class="be-not-found-link-name">Getting started</span>
                <span class="be-not-found-link-text">Install the package and draw your first chart.</span>
            </a>
            <a class="be-not-found-link" href="@DemoRouteConstants.Demos_Samples">
                <i class="bi bi-display-fill" aria-hidden="true"></i>
                <span class="be-not-found-link-name">Samples gallery</span>
                <span class="be-not-found-link-text">Search every chart sample by type, category or tag.</span>
            </a>
            <a class="be-not-found-link" href="@DemoRouteConstants.Blog_Releases">
                <i class="bi bi-megaphone-fill" aria-hidden="true"></i>
                <span class="be-not-found-link-name">Releases</span>
                <span class="be-not-found-link-text">See what changed in each version.</span>
            </a>
        </div>
    </section>
</div>

@code {
    private const string pageUrl = DemoRouteConstants.Not_Found;

    // The address that led here, shown only when the router sent an unknown URL (not when /not-found is opened directly).
    // The page has no parameters, so Blazor keeps the same instance without calling OnParametersSet when the user moves
    // from one unknown URL to another; LocationChanged keeps the shown address current.
    private string? requestedPath;

    protected override void OnInitialized()
    {
        requestedPath = GetRequestedPath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        requestedPath = GetRequestedPath(e.Location);
        StateHasChanged();
    }

    private string? GetRequestedPath(string uri)
    {
        var path = "/" + NavigationManager.ToBaseRelativePath(uri);
        var queryOrFragment = path.IndexOfAny(['?', '#']);
        if (queryOrFragment >= 0)
            path = path[..queryOrFragment];

        return string.Equals(path.TrimEnd('/'), pageUrl, StringComparison.OrdinalIgnoreCase) ? null : path;
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}

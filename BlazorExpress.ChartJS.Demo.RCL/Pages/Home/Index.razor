@attribute [Route(pageUrl)]

<SiteMetaTags PageUrl="@pageUrl" Title="@metaTitle" Description="@metaDescription" ImageUrl="@imageUrl" />

@* The home page in the Aurora style (story 26111801). The be-home-aurora class also swaps the shared masthead glow for the home palette. *@
<div class="be-home be-home-aurora">
    <section class="be-home-hero container is-max-desktop">
        @* The release pill spans the whole hero, above both columns (QF-26112003). *@
        <a class="be-home-pill" href="@releaseNotesUrl">
            <span class="be-home-pill-tag">New in @version</span>
            <span class="be-home-pill-text">@releaseShortDescription</span>
            <span aria-hidden="true">→</span>
        </a>
        <div class="be-home-hero-grid">
            <div class="be-home-hero-text">
                <h1 class="be-home-title">Chart.js charts for Blazor, <span class="be-home-gradient-text">configured in C#</span></h1>
                <p class="be-home-lead">@pageDescription</p>
                <div class="be-home-badges">
                    <a href="@nugetUrl" target="_blank" rel="noopener noreferrer"><img alt="NuGet version" height="20" src="https://img.shields.io/nuget/v/BlazorExpress.ChartJS"><span class="is-sr-only"> (opens in a new tab)</span></a>
                    <a href="@nugetUrl" target="_blank" rel="noopener noreferrer"><img alt="NuGet downloads" height="20" src="https://img.shields.io/nuget/dt/BlazorExpress.ChartJS"><span class="is-sr-only"> (opens in a new tab)</span></a>
                </div>
                <HomeInstallCommand />
                <div class="buttons be-home-actions">
                    <a class="button is-medium be-home-btn-primary" href="@DemoRouteConstants.Docs_Getting_Started_Introduction">Get started</a>
                    <a class="button is-medium be-home-btn-secondary" href="@DemoRouteConstants.Demos_Samples">Browse @SampleCatalog.All.Count samples</a>
                </div>
            </div>
            <HomeHeroChart />
        </div>
    </section>

    <div class="container is-max-desktop">
        <section class="be-home-features" aria-label="Features">
            @foreach (var feature in features)
            {
                <div class="be-home-feature">
                    <BootstrapIcon Name="@feature.Icon" />
                    <strong class="be-home-feature-title">@feature.Title</strong>
                    <span class="be-home-feature-text">@feature.Text</span>
                </div>
            }
        </section>

        <section class="be-home-section" aria-labelledby="be-home-charts-title">
            <h2 id="be-home-charts-title" class="be-home-section-title">Charts</h2>
            <div class="be-home-charts">
                @foreach (var chart in SampleCatalog.Charts)
                {
                    <a class="be-home-chart" href="@chart.Route">
                        <BootstrapIcon Name="@chart.IconName" />
                        <span class="be-home-chart-name">@chart.Name</span>
                        <span class="be-home-chart-count">@SampleCatalog.GetByChart(chart.Key).Count samples</span>
                    </a>
                }
            </div>
        </section>

        <section class="be-home-section" aria-labelledby="be-home-categories-title">
            <h2 id="be-home-categories-title" class="be-home-section-title">Browse by category</h2>
            <div class="tags are-medium is-centered be-home-categories">
                @foreach (var category in Enum.GetValues<SampleCategory>())
                {
                    <a class="tag is-link is-light" href="@DemoRouteConstants.GetSamplesCategoryUrl(category)">@category.GetDisplayName()</a>
                }
            </div>
            <div class="has-text-centered">
                <a class="be-home-link" href="@DemoRouteConstants.Demos_ColorUtils">
                    <BootstrapIcon Name="BootstrapIconName.Palette2" />
                    <span>Color Utils</span>
                </a>
            </div>
        </section>

        <section class="be-home-compat" aria-label="Supported tech stack">
            <span><strong>2.0.0+</strong> .NET 8, 9, 10, 11</span>
            <span>Chart.js 4.6.1</span>
            <span>chartjs-plugin-datalabels 2.2.0</span>
            <a href="@($"{DemoRouteConstants.Docs_Getting_Started_Introduction}#supported-tech-stack")">All versions <span aria-hidden="true">→</span></a>
        </section>

        <DemoDoYouKnow />

        <div class="be-home-star">
            <DemoStarOnGitHub />
        </div>
    </div>
</div>

@code {
    private const string imageUrl = DemoImageSrcConstants.LineChart;
    private const string metaDescription = $"{DemoStringConstants.NugetPackageName} is an open-source Blazor component library for Chart.js: eight chart types with typed C# data and options, on .NET 8 to 11.";
    private const string metaTitle = "Blazor Chart.js Components for .NET";
    private const string pageDescription = "Eight chart types as Razor components with typed data, datasets and options. Free and open source, on .NET 8 to 11.";
    private const string pageUrl = "/";

    private static readonly (BootstrapIconName Icon, string Title, string Text)[] features =
    [
        (BootstrapIconName.CodeSlash, "Typed C# options", "Data, datasets, options and plugins as C# classes."),
        (BootstrapIconName.Clock, "Time axes built in", "Date labels and points with no date-adapter script."),
        (BootstrapIconName.HandIndex, "Events and methods", "Click and hover events; hide, update and resize charts."),
        (BootstrapIconName.Braces, "JavaScript callbacks", "Register a function by name and use it from C#."),
        (BootstrapIconName.PlayCircle, "Animated updates", "Charts move smoothly from old values to new ones."),
        (BootstrapIconName.Windows, ".NET 8 to 11", "Blazor WebAssembly, Server and .NET MAUI Blazor Hybrid."),
    ];

    private string nugetUrl = default!;
    private string releaseNotesUrl = default!;
    private string releaseShortDescription = default!;
    private string version = default!;

    [Inject] public IConfiguration Configuration { get; set; } = default!;

    protected override void OnInitialized()
    {
        var configuredVersion = Configuration["version"]!; // example: 2.0.0
        version = $"v{configuredVersion}";
        // Each release publishes its notes at /blog/releases/<major>-<minor>-<patch> (story 26111801, finalize A-03).
        releaseNotesUrl = $"{DemoRouteConstants.Blog_Releases_Prefix}/{configuredVersion.Replace('.', '-')}";
        releaseShortDescription = Configuration["release:short_description"]!;
        nugetUrl = $"{Configuration["urls:nuget"]}";
    }
}

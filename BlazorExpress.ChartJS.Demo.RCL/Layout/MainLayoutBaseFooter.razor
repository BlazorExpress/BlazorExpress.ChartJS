@namespace BlazorExpress.ChartJS.Demo.RCL
@inherits ComponentBase

@* Two tiers (QF-26112002): the team's other libraries sit in their own band on the page background, and the footer starts
   below it with a violet top edge, so the two read as separate sections. *@
<section class="be-footer-libraries" aria-labelledby="be-footer-libraries-title">
    <div class="be-footer-libraries-layout">
        <div class="be-footer-libraries-intro">
            <h2 id="be-footer-libraries-title" class="be-footer-libraries-title">More from the team</h2>
            <p class="be-footer-libraries-lead">Other open-source .NET libraries by the BlazorExpress team.</p>
        </div>
        <ul class="be-footer-libraries-grid">
            @foreach (var library in libraries)
            {
                <li>
                    <a class="be-footer-library" href="@library.Url" target="_blank" rel="noopener noreferrer">
                        <img class="be-footer-library-logo" src="@library.LogoSrc" width="40" height="40" alt="" />
                        <span class="be-footer-library-text">
                            <span class="be-footer-library-name">@foreach (var segment in GetNameSegments(library.Name)){@segment<wbr />}<span class="is-sr-only"> (opens in a new tab)</span></span>
                            <span class="be-footer-library-description">@library.Description</span>
                        </span>
                        <i class="bi bi-box-arrow-up-right be-footer-library-external" aria-hidden="true"></i>
                    </a>
                </li>
            }
        </ul>
    </div>
</section>
<footer class="footer be-footer">
    <div class="columns">
        <div class="column is-one-third-tablet">
            <div class="be-footer-brand is-flex is-flex-direction-row is-align-items-center mb-2">
                <div class="mr-2">
                    <Image Src="@DemoStringConstants.StaticAssets_Icons_Logo_svg"
                           Dimension="ImageDimension.Is32x32"
                           alt="" />
                </div>
                <div class="be-footer-brand-name is-size-4">@foreach (var segment in GetNameSegments(DemoStringConstants.NugetPackageName)){@segment<wbr />}</div>
            </div>
            <p class="be-footer-tagline">An open-source Blazor component library for Chart.js charts, configured in C#.</p>
            <ul class="be-footer-social">
                @if (!string.IsNullOrWhiteSpace(GithubUrl))
                {
                    <li><a href="@GithubUrl" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)"><i class="bi bi-github" aria-hidden="true"></i></a></li>
                }
                @if (!string.IsNullOrWhiteSpace(TwitterUrl))
                {
                    <li><a href="@TwitterUrl" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter) (opens in a new tab)"><i class="bi bi-twitter-x" aria-hidden="true"></i></a></li>
                }
                @if (!string.IsNullOrWhiteSpace(LinkedInUrl))
                {
                    <li><a href="@LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)"><i class="bi bi-linkedin" aria-hidden="true"></i></a></li>
                }
            </ul>
        </div>
        <div class="column is-hidden-touch"></div>
        <nav class="column" aria-labelledby="be-footer-links-title">
            <h2 id="be-footer-links-title" class="be-footer-title">Links</h2>
            <ul class="menu-list">
                <li><a href="/">Home</a></li>
                <li><a href="@DemoRouteConstants.Docs_Getting_Started_Introduction">Docs</a></li>
                <li><a href="@DemoRouteConstants.Demos_Prefix">Demos</a></li>
                @* <li><a href="/">Blog</a></li> *@
                <li><a href="@GithubUrl" target="_blank" rel="noopener noreferrer">GitHub<span class="is-sr-only"> (opens in a new tab)</span></a></li>
            </ul>
        </nav>
        <nav class="column" aria-labelledby="be-footer-guides-title">
            <h2 id="be-footer-guides-title" class="be-footer-title">Guides</h2>
            <ul class="menu-list">
                <li><a href="@DemoRouteConstants.Docs_Getting_Started_Introduction">Getting started</a></li>
                @* <li><a href="/">Install NuGet package</a></li> *@
                @* <li><a href="/">Starter templates</a></li> *@
            </ul>
        </nav>
        <nav class="column" aria-labelledby="be-footer-community-title">
            <h2 id="be-footer-community-title" class="be-footer-title">Community</h2>
            <ul class="menu-list">
                <li><a href="@GithubIssuesUrl" target="_blank" rel="noopener noreferrer">Issues<span class="is-sr-only"> (opens in a new tab)</span></a></li>
                <li><a href="@GithubDiscussionsUrl" target="_blank" rel="noopener noreferrer">Discussions<span class="is-sr-only"> (opens in a new tab)</span></a></li>
                @* <li><a href="@OpenCollectiveUrl" target="_blank">Open Collective</a></li> *@
                <li><a href="@StackoverflowUrl" target="_blank" rel="noopener noreferrer">Stack Overflow<span class="is-sr-only"> (opens in a new tab)</span></a></li>
            </ul>
        </nav>
    </div>
    <div class="be-footer-bar">
        <ul class="be-footer-facts">
            <li>Apache License 2.0</li>
            @if (!string.IsNullOrWhiteSpace(Version))
            {
                <li>@Version</li>
            }
            @if (!string.IsNullOrWhiteSpace(DotNetVersion))
            {
                <li>Powered by @DotNetVersion</li>
            }
        </ul>
        <p>Made with <i class="bi bi-heart-fill has-text-danger" aria-hidden="true"></i><span class="is-sr-only">love</span> by the <b>BlazorExpress</b> team and our contributors.</p>
    </div>
</footer>

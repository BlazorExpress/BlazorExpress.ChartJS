@namespace BlazorExpress.ChartJS.Demo.RCL

@* The gradient navbar of every page (story 26111801 CR-001). The current section is marked from the address. *@
<Navbar Class="px-3 be-demo-navbar" HasShadow="true">
    <NavbarBrand>
        <NavbarItem Href="@DemoRouteConstants.Home_Prefix" aria-label="@ApplicationName">
            <img class="be-navbar-brand-mark" src="@BrandImgSrc" alt="@BrandImgAltText" width="36" height="36" />
            <span class="be-navbar-brand-name ml-2 has-text-weight-bold">@ApplicationName</span>
        </NavbarItem>
        <NavbarBurger TargetId="@navbarMenuId" IsActive="@isNavbarMenuActive" ActiveStateChanged="ToggleNavbarMenu">
            <i class="bi bi-three-dots-vertical"></i>
        </NavbarBurger>
    </NavbarBrand>

    <NavbarMenu Id="@navbarMenuId" IsActive="@isNavbarMenuActive">
        <NavbarStart>
            <NavbarItem Class="@GetSectionClass(DemoRouteConstants.Docs_Prefix)" Href="@DemoRouteConstants.Docs_Prefix" IsHoverable="true" aria-current="@GetAriaCurrent(DemoRouteConstants.Docs_Prefix, DemoRouteConstants.Docs_Prefix)">
                <i class="bi bi-file-text-fill be-demo-navbar-icon be-demo-navbar-icon-docs mr-2"></i>Docs
            </NavbarItem>
            <NavbarItem Class="@GetSectionClass(DemoRouteConstants.Demos_Prefix)" Href="@DemoRouteConstants.Demos_Prefix" IsHoverable="true" aria-current="@GetAriaCurrent(DemoRouteConstants.Demos_Prefix, DemoRouteConstants.Demos_Prefix)">
                <i class="bi bi-display-fill be-demo-navbar-icon be-demo-navbar-icon-demos mr-2"></i>Demos
            </NavbarItem>
            <NavbarItem Class="@GetSectionClass(DemoRouteConstants.Blog_Prefix)" Href="@DemoRouteConstants.Blog_Releases" IsHoverable="true" aria-current="@GetAriaCurrent(DemoRouteConstants.Blog_Prefix, DemoRouteConstants.Blog_Releases)">
                <i class="bi bi-megaphone-fill be-demo-navbar-icon be-demo-navbar-icon-releases mr-2"></i>Releases
            </NavbarItem>
        </NavbarStart>
        <NavbarEnd>
            <NavbarItem Class="mr-1" Href="@githubUrl" IsHoverable="true" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)">
                <i class="bi bi-github" aria-hidden="true"></i>
                <small class="is-hidden-desktop ml-2">GitHub</small>
            </NavbarItem>
            <NavbarItem Class="mr-1" Href="@twitterUrl" IsHoverable="true" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter) (opens in a new tab)">
                <i class="bi bi-twitter-x" aria-hidden="true"></i>
                <small class="is-hidden-desktop ml-2">Twitter</small>
            </NavbarItem>
            <NavbarItem Href="@linkedInUrl" IsHoverable="true" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">
                <i class="bi bi-linkedin" aria-hidden="true"></i>
                <small class="is-hidden-desktop ml-2">LinkedIn</small>
            </NavbarItem>
            <NavbarItem Type="NavbarItemType.Div" IsHoverable="true">
                <span class="tag is-link">@version</span>
            </NavbarItem>

            <NavbarItem Type="NavbarItemType.Div" HasDropdown="true" IsHoverable="true">
                <NavbarLink Class="be-bulma-theme-indicator" aria-label="Theme" aria-haspopup="true">
                    <i class="bi bi-sun"></i>
                </NavbarLink>
                <NavbarDropdown Class="px-1" Position="NavbarDropdownPosition.Right">
                    <NavbarItem Class="be-bulma-theme-item is-clickable" IsHoverable="true" data-scheme="light" @onclick="SetLightTheme">
                        <i class="bi bi-sun mr-2"></i>Light
                    </NavbarItem>
                    <NavbarItem Class="be-bulma-theme-item is-clickable my-1" IsHoverable="true" data-scheme="dark" @onclick="SetDarkTheme">
                        <i class="bi bi-moon-stars-fill mr-2"></i>Dark
                    </NavbarItem>
                    <NavbarItem Class="be-bulma-theme-item is-clickable" IsHoverable="true" data-scheme="system" @onclick="SetAutoTheme">
                        <i class="bi bi-circle-half mr-2"></i>Auto
                    </NavbarItem>
                </NavbarDropdown>
            </NavbarItem>
        </NavbarEnd>
    </NavbarMenu>
</Navbar>
